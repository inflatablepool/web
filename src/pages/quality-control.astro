---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import type { MetaData } from '~/types';
import { POOL_PRESSURE_SPECS } from '~/data/pool-catalog';

export const prerender = true;

const metadata = merge(
  {
    title: `Inflatable Pool Quality Control & Testing | ${SITE.name}`,
    description: `Inflatable pool quality control: pressure and leak testing, seam and valve checks, dimensional and packing verification, with methods confirmed per project.`,
    canonical: getCanonical('/quality-control'),
    robots: { index: true, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;

const claimEvidence = [
  {
    claim: 'Rigid walls at rated pressure',
    applies: 'Drop-stitch pool models',
    verification: 'Inflation and pressure/leak check against the approved model specification',
    result: 'Units are released only when they meet the agreed specification',
    limitations: 'Rigidity depends on inflating to the pressure specified for each model — see product documentation',
  },
  {
    claim: 'Model-specific operating pressure',
    applies: 'Pool and SPA tub models',
    verification: 'Pressure target, relief-valve setting and test criteria are confirmed in the model specification',
    result: 'Production and inspection use the approved pressure target',
    limitations: 'Do not exceed the rated pressure for each model; higher pressure does not increase stiffness safely',
  },
  {
    claim: 'Inflation time stated per model',
    applies: 'Standard models',
    verification: 'Measured with the specified pump and confirmed in the product documentation',
    result: 'Inflation time depends on model size, pump and ambient conditions',
    limitations:
      'Excludes site preparation and water filling — filling time varies with pool capacity and water supply',
  },
  {
    claim: 'Drop-stitch wall construction',
    applies: 'Drop-stitch collections',
    verification:
      'Construction is specified in the approved bill of materials and shown in product videos where available',
    result: 'Wall construction follows the approved product specification',
    limitations:
      'Walls are not designed for sitting, standing or jumping unless the model documentation explicitly permits it. Always follow the product manual and site-specific safety requirements.',
  },
  {
    claim: 'UV-resistant double-layer PVC',
    applies: 'Drop-stitch pool models',
    verification: 'Material specification and supplier documentation reviewed per project',
    result: 'Material options are confirmed against target-market requirements',
    limitations: 'Cover the pool when not in use for longest material life; store dry and out of sun in the off-season',
  },
  {
    claim: 'Residential design references',
    applies: 'Residential pool models, where specified',
    verification: 'Applicable standards, test methods and declarations are reviewed during project confirmation',
    result: 'Compliance scope and documentation are confirmed before production',
    limitations:
      'Design references do not by themselves certify a product or commercial installation; public-use and SPA requirements must be confirmed separately',
  },
];

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Quality Control' }];

const qcChecks = [
  {
    icon: 'tabler:gauge',
    title: 'Pressure & Leak Test',
    description:
      'Pressure and leak testing is performed to the method, hold time and acceptance criteria agreed in the approved production specification.',
  },
  {
    icon: 'tabler:circle-dot',
    title: 'Valve & Seal Verification',
    description:
      'Filter-pump ports, shut-off valves, drain valves and over-inflation safety valves are checked for air and water tightness to the agreed inspection plan after heat-sealing.',
  },
  {
    icon: 'tabler:search',
    title: 'Seam & Rail Inspection',
    description:
      'Welded seams, reinforced rail bands and corners are inspected as part of the agreed inspection plan for continuity, flatness and specification adherence.',
  },
  {
    icon: 'tabler:ruler-measure',
    title: 'Dimensional Control',
    description:
      'Finished height, diameter and squareness are checked against the approved engineering drawings or specification.',
  },
  {
    icon: 'tabler:shield',
    title: 'Material Compliance',
    description:
      'Material options, including UV-resistant double-layer drop-stitch PVC, are reviewed against the target-market requirements. Compliance documentation is confirmed per project.',
  },
  {
    icon: 'tabler:package-export',
    title: 'Packing & Loading Check',
    description:
      'Inclusions (pump, repair kit and covers where applicable) are verified against the approved packing list before carton sealing and container loading.',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-4 md:px-6 pt-12 md:pt-16 pb-10 mx-auto max-w-6xl">
    <header class="mb-10 md:mb-12 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Quality Control</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Quality Control & Testing for Inflatable Pools
      </h1>
      <p class="mt-4 text-xl text-gray-500 dark:text-slate-400 font-medium">
        Each project starts with an agreed inspection plan. This page describes the QC framework we apply to drop-stitch
        pool production; test methods, hold times, acceptance criteria and compliance documentation are confirmed for
        each product and market in the approved specification.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/request-quotation"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-slate-700 text-white font-semibold rounded-full hover:bg-gray-800 dark:hover:bg-slate-600 transition-all text-sm"
        >
          <Icon name="tabler:file-invoice" class="w-4 h-4" /> Request a Quote
        </a>
        <a
          href="/manufacturing"
          class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-slate-600 font-semibold rounded-full hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm"
        >
          <Icon name="tabler:building-factory" class="w-4 h-4" /> Manufacturing Process
        </a>
      </div>
    </header>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">Six QC Checkpoints</h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5">
        Quality control is planned as a sequence of checks across production, ending with finished-product verification.
        The applicable checkpoints are confirmed in the approved inspection plan.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          qcChecks.map((c) => (
            <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <span class="mb-3 flex w-10 h-10 items-center justify-center rounded-xl bg-sky-100 dark:bg-sky-900/50 text-primary dark:text-sky-300">
                <Icon name={c.icon} class="w-5 h-5" />
              </span>
              <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1.5">{c.title}</h3>
              <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{c.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">Pressure Test Standards</h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5">
        Pressure targets are confirmed per model in the approved specification. The values below describe the standard
        platform and do not replace the project specification.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {
          POOL_PRESSURE_SPECS.map((p) => (
            <div class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-1">
                {p.label}
              </div>
              <div class="text-sm font-bold text-gray-900 dark:text-slate-100">{p.value}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">
        Performance Claims & Evidence
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5">
        The table shows how standard platform claims are verified and where their limits are. Model-specific values and
        documentation are confirmed in the approved specification.
      </p>
      <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-slate-700">
        <table class="w-full text-sm min-w-[768px]">
          <thead>
            <tr
              class="bg-gray-50 dark:bg-slate-800/70 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400"
            >
              <th class="px-4 py-3">Claim</th>
              <th class="px-4 py-3">Applies To</th>
              <th class="px-4 py-3">Test / Verification</th>
              <th class="px-4 py-3">Result</th>
              <th class="px-4 py-3">Use Limitations</th>
            </tr>
          </thead>
          <tbody>
            {
              claimEvidence.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-800/40'}>
                  <td class="px-4 py-2.5 font-medium text-gray-800 dark:text-slate-200 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.claim}
                  </td>
                  <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.applies}
                  </td>
                  <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.verification}
                  </td>
                  <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.result}
                  </td>
                  <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.limitations}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-3">
        Demo videos for inflation and rigidity are published at{' '}
        <a href="/products/specs#videos" class="text-primary dark:text-sky-400 hover:underline">Product Videos</a>.
        Model-level safety and use documentation is provided with each product.
      </p>
    </section>

    <section class="mb-14 p-6 rounded-2xl border border-gray-200 dark:border-slate-700">
      <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-3">After-Sales Commitment</h2>
      <p class="text-sm text-gray-600 dark:text-slate-400">
        Standard orders include a repair kit for field fixes. Spare parts and replacement components are available
        through our support team at info@inflatablepoolfactory.com; availability and terms are confirmed with your
        order. Wholesale and OEM partners can discuss spare-part planning with their order.
      </p>
    </section>

    <section class="mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-3">Related B2B Pages</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a
          href="/manufacturing"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Manufacturing Process</a
        >
        <a
          href="/wholesale"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Wholesale Program</a
        >
        <a
          href="/oem-odm"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >OEM / ODM</a
        >
        <a
          href="/products/specs#pressure"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Full Specifications</a
        >
      </div>
    </section>

    <section class="mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-3">Guides for Buyers</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a
          href="/guides/inflatable-pool-pressure-testing-explained"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Pressure Testing Explained</a
        >
        <a
          href="/guides/how-to-choose-a-drop-stitch-pool-manufacturer"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Choosing a Manufacturer</a
        >
      </div>
    </section>
  </section>

  <section class="sr-only" data-ai-block="quality-control" aria-hidden="true">
    <p>
      Inflatable Pool Factory inflatable pool quality control: a project-specific inspection plan covering pressure and
      leak testing, valve and seal verification (filter-pump ports, shut-off valves, drain valves, over-inflation safety
      valves), seam and reinforced rail inspection, dimensional control against approved drawings, material
      documentation and packing checks against the agreed inclusion list. Test method, hold time and acceptance criteria
      are confirmed in the approved production specification. Model pressure targets, relief-valve settings and
      tolerances are confirmed in the product specification. After-sales: repair kit included; spare parts (valves,
      patches, pumps, covers) available via info@inflatablepoolfactory.com, with availability and terms confirmed per
      order. Material and compliance documentation is reviewed against the target market; EN 16582-1, ASTM F2666 and
      other design references are applied only where confirmed for the specific residential model and do not by
      themselves certify a product or commercial installation.
    </p>
  </section>
</Layout>
