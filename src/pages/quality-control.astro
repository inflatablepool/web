---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import type { MetaData } from '~/types';
import { POOL_PRESSURE_SPECS } from '~/data/pool-catalog';

export const prerender = true;

const metadata = merge(
  {
    title: `Inflatable Pool Quality Control & Testing | ${SITE.name}`,
    description: `Inflatable Pool Factory quality control: 24–48 hour pressure-drop tests, seam and valve inspection, relief-valve verification and packing checks on every inflatable pool before shipping.`,
    canonical: getCanonical('/quality-control'),
    robots: { index: true, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;

const claimEvidence = [
  {
    claim: 'Rigid walls at rated pressure',
    applies: 'All collections',
    verification: 'Inflated to rated operating pressure; 24–48 hour pressure-drop test on 100% of units',
    result: 'No measurable pressure drop, deformation or leak at hold time',
    limitations: 'Rigidity depends on inflating to the pressure specified for each model — see product documentation',
  },
  {
    claim: 'Rated operating pressure 4–5 PSI',
    applies: 'All pool and SPA tub models',
    verification: 'Factory QC test at 6 PSI; maximum tolerance 8 PSI; pressure-relief valve auto-release above 6 PSI',
    result: 'Published pressure limits enforced on every production unit, not on a sample basis',
    limitations: 'Do not exceed the rated pressure for each model; higher pressure does not increase stiffness safely',
  },
  {
    claim: 'Inflation in 5–15 minutes',
    applies: 'All models',
    verification: 'Using the included 1000W electric air pump, per model',
    result: 'Full rigidity reached within the published range depending on model size',
    limitations:
      'Excludes site preparation and water filling — filling time varies with pool capacity and water supply',
  },
  {
    claim: 'Drop-stitch wall construction',
    applies: 'All collections',
    verification: 'Demonstrated in the product demo videos — inflation and rigidity under load',
    result: 'Walls hold shape when filled; see the videos at /products/specs#videos',
    limitations: 'Walls are not designed for sitting, standing or jumping unless stated for a specific model',
  },
  {
    claim: 'UV-resistant, REACH-compliant PVC',
    applies: 'All collections',
    verification: 'Material compliance check on double-layer drop-stitch PVC per production batch',
    result: 'Full-season outdoor service life in normal residential use',
    limitations: 'Cover the pool when not in use for longest material life; store dry and out of sun in the off-season',
  },
  {
    claim: 'Safety standards EN 16582-1 / ASTM F2666',
    applies: 'Residential pool models',
    verification: 'Design reference; model-specific safety information provided in the product documentation',
    result: 'Residential designs reference the applicable clauses of both standards',
    limitations:
      'Design reference only — excludes public-use pools and SPA tubs; does not certify commercial installations',
  },
];

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Quality Control' }];

const qcChecks = [
  {
    icon: 'tabler:gauge',
    title: '24–48 Hour Pressure-Drop Test',
    description:
      'Every completed pool is inflated to its rated operating pressure and held for 24–48 hours. Any measurable pressure drop, deformation or leak means the unit does not ship.',
  },
  {
    icon: 'tabler:circle-dot',
    title: 'Valve & Seal Verification',
    description:
      'Filter-pump ports, shut-off valves, drain valves and over-inflation safety valves are individually checked for absolute air and water tightness after heat-sealing.',
  },
  {
    icon: 'tabler:search',
    title: 'Full Seam & Rail Inspection',
    description:
      'Welded seams, reinforced rail bands and corners are visually inspected on every unit for continuity, flatness and spec adherence — no skipped stitches, no pinholes.',
  },
  {
    icon: 'tabler:ruler-measure',
    title: 'Dimensional Control',
    description:
      'Finished height, diameter and squareness are checked against engineering drawings so pools match the published dimensions and packed sizes on the price list.',
  },
  {
    icon: 'tabler:shield',
    title: 'Material Compliance',
    description:
      'UV-resistant, REACH-compliant double-layer drop-stitch PVC with proven full-season outdoor service life — the same fabric family as our SUP boards.',
  },
  {
    icon: 'tabler:package-export',
    title: 'Packing & Loading Check',
    description:
      'Inclusions (1000W pump, repair kit, covers where applicable) are verified against the packing list before carton sealing and container loading.',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-4 md:px-6 pt-12 md:pt-16 pb-10 mx-auto max-w-6xl">
    <header class="mb-10 md:mb-12 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Quality Control</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Quality Control & Testing for Every Pool
      </h1>
      <p class="mt-4 text-xl text-gray-500 dark:text-slate-400 font-medium">
        No Inflatable Pool Factory pool leaves the factory without passing a 24–48 hour pressure-drop test and a full
        inspection of seams, valves and dimensions. This is the QC system behind our wholesale and OEM/ODM programs.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/request-quotation"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-slate-700 text-white font-semibold rounded-full hover:bg-gray-800 dark:hover:bg-slate-600 transition-all text-sm"
        >
          <Icon name="tabler:file-invoice" class="w-4 h-4" /> Request a Quote
        </a>
        <a
          href="/manufacturing"
          class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-slate-600 font-semibold rounded-full hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm"
        >
          <Icon name="tabler:building-factory" class="w-4 h-4" /> Manufacturing Process
        </a>
      </div>
    </header>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">
        Six Checks Before Packing
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5">
        Quality at Inflatable Pool Factory is not a final random spot-check — it is a sequence of checks woven through
        production, ending with a hold-time test that verifies the finished product as a whole.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          qcChecks.map((c) => (
            <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <span class="mb-3 flex w-10 h-10 items-center justify-center rounded-xl bg-sky-100 dark:bg-sky-900/50 text-primary dark:text-sky-300">
                <Icon name={c.icon} class="w-5 h-5" />
              </span>
              <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1.5">{c.title}</h3>
              <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{c.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">Pressure Test Standards</h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5">
        Published pressure limits are enforced on 100% of production — not on a sample basis.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {
          POOL_PRESSURE_SPECS.map((p) => (
            <div class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-1">
                {p.label}
              </div>
              <div class="text-sm font-bold text-gray-900 dark:text-slate-100">{p.value}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">
        Performance Claims & Evidence
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5">
        Every performance claim on this site maps to how it is verified, which models it applies to, and where its
        limits are. Model-specific values and documentation ship with each product.
      </p>
      <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-slate-700">
        <table class="w-full text-sm min-w-[768px]">
          <thead>
            <tr
              class="bg-gray-50 dark:bg-slate-800/70 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400"
            >
              <th class="px-4 py-3">Claim</th>
              <th class="px-4 py-3">Applies To</th>
              <th class="px-4 py-3">Test / Verification</th>
              <th class="px-4 py-3">Result</th>
              <th class="px-4 py-3">Use Limitations</th>
            </tr>
          </thead>
          <tbody>
            {
              claimEvidence.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-800/40'}>
                  <td class="px-4 py-2.5 font-medium text-gray-800 dark:text-slate-200 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.claim}
                  </td>
                  <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.applies}
                  </td>
                  <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.verification}
                  </td>
                  <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.result}
                  </td>
                  <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800 align-top">
                    {row.limitations}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-3">
        Demo videos for inflation and rigidity are published at{' '}
        <a href="/products/specs#videos" class="text-primary dark:text-sky-400 hover:underline">Product Videos</a>.
        Model-level safety and use documentation is provided with each product.
      </p>
    </section>

    <section class="mb-14 p-6 rounded-2xl border border-gray-200 dark:border-slate-700">
      <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-3">After-Sales Commitment</h2>
      <p class="text-sm text-gray-600 dark:text-slate-400">
        Every pool ships with a repair kit for field fixes, and spare parts — valves, patches, pumps and covers — remain
        available through our support team at info@inflatablepoolfactory.com for the life of the product. Wholesale and
        OEM partners receive priority spare-part allocation with their orders.
      </p>
    </section>

    <section class="mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-3">Related B2B Pages</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a
          href="/manufacturing"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Manufacturing Process</a
        >
        <a
          href="/wholesale"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Wholesale Program</a
        >
        <a
          href="/oem-odm"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >OEM / ODM</a
        >
        <a
          href="/products/specs#pressure"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Full Specifications</a
        >
      </div>
    </section>

    <section class="mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-3">Guides for Buyers</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a
          href="/guides/inflatable-pool-pressure-testing-explained"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Pressure Testing Explained</a
        >
        <a
          href="/guides/how-to-choose-a-drop-stitch-pool-manufacturer"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Choosing a Manufacturer</a
        >
      </div>
    </section>
  </section>

  <section class="sr-only" data-ai-block="quality-control" aria-hidden="true">
    <p>
      Inflatable Pool Factory inflatable pool quality control: 100% of production units pass a 24–48 hour pressure-drop
      test at rated operating pressure before shipping; individual valve and seal verification (filter-pump ports,
      shut-off valves, drain valves, over-inflation safety valves); full seam and reinforced rail inspection;
      dimensional control against engineering drawings; REACH-compliant UV-resistant double-layer drop-stitch PVC;
      packing and loading checks against the inclusion list (1000W pump, repair kit, covers). Pressure standards: 4–5
      PSI recommended operating, 6 PSI factory QC test, 8 PSI maximum tolerance, pressure-relief valve auto-release
      above 6 PSI. After-sales: repair kit included, spare parts (valves, patches, pumps, covers) available via
      info@inflatablepoolfactory.com, priority spare-part allocation for wholesale and OEM partners. Evidence mapping
      for performance claims: rigid walls at rated pressure (24–48 hour pressure-drop test, 100% of units); 4–5 PSI
      rated operating pressure with 6 PSI factory QC test, 8 PSI maximum tolerance and pressure-relief valve above 6
      PSI; inflation in 5–15 minutes with the included 1000W pump excluding site preparation and water filling;
      drop-stitch wall construction demonstrated in the product demo videos at /products/specs#videos, walls not
      designed for sitting, standing or jumping unless stated for a specific model; UV-resistant REACH-compliant PVC
      with full-season outdoor service life in normal residential use, cover when not in use and store dry out of sun;
      EN 16582-1 and ASTM F2666 are design references for residential pool models only — they exclude public-use pools
      and SPA tubs and do not certify commercial installations.
    </p>
  </section>
</Layout>
