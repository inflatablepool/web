---
const PAGE_DESC: Record<string, { description: string }> = {
  de: {
    description: 'Nehmen Sie Kontakt mit Inflatable Pool Factory auf.',
  },
  es: {
    description: 'Póngase en contacto con Inflatable Pool Factory.',
  },
  fr: {
    description: 'Contactez Inflatable Pool Factory.',
  },
  it: {
    description: 'Contatta Inflatable Pool Factory.',
  },
  cs: {
    description: 'Kontaktujte společnost Inflatable Pool Factory.',
  },
  sv: {
    description: 'Kontakta Inflatable Pool Factory.',
  },
  da: {
    description: 'Kontakt Inflatable Pool Factory.',
  },
  el: {
    description: 'Επικοινωνήστε με Inflatable Pool Factory.',
  },
  no: {
    description: 'Kontakt Inflatable Pool Factory.',
  },
  ru: {
    description: 'Свяжитесь с Inflatable Pool Factory.',
  },
  nl: {
    description: 'Neem contact op met Inflatable Pool Factory.',
  },
  fi: {
    description: 'Ota yhteyttä Inflatable Pool Factory.',
  },
  pl: {
    description: 'Skontaktuj się z Inflatable Pool Factory.',
  },
  ar: {
    description: 'جهة الاتصال Inflatable Pool Factory.',
  },
  pt: {
    description: 'Contato Inflatable Pool Factory.',
  },
};
const PAGE_META: Record<string, { title: string }> = {
  de: { title: 'Kontakt' },
  es: { title: 'Contacto' },
  fr: { title: 'Contact' },
  it: { title: 'Contatti' },
  pt: { title: 'Contato' },
  ar: { title: 'اتصل بنا' },
  ru: { title: 'Контакты' },
  pl: { title: 'Kontakt' },
  nl: { title: 'Contact' },
  sv: { title: 'Kontakt' },
  no: { title: 'Kontakt' },
  el: { title: 'Επικοινωνία' },
  fi: { title: 'Yhteystiedot' },
  da: { title: 'Kontakt' },
  cs: { title: 'Kontakt' },
};
const HUB_TEXT: Record<
  string,
  { cardTitle: string; hqTitle: string; hubTitle: string; emailTitle: string; emailNote: string }
> = {
  en: {
    cardTitle: 'Contact Information',
    hqTitle: 'Qingdao Office — Qingdao Vatrad Group',
    hubTitle: 'Manufacturing & Export Hub',
    emailTitle: 'General enquiries',
    emailNote: 'GMT+8 - Qingdao, China',
  },
  de: {
    cardTitle: 'Kontaktinformationen',
    hqTitle: 'Qingdao-Büro — Qingdao Vatrad Group',
    hubTitle: 'Fertigungs- & Exportzentrum',
    emailTitle: 'Allgemeine Anfragen',
    emailNote: 'GMT+8 - Qingdao, China',
  },
  es: {
    cardTitle: 'Información de contacto',
    hqTitle: 'Oficina de Qingdao — Qingdao Vatrad Group',
    hubTitle: 'Centro de producción y exportación',
    emailTitle: 'Consultas generales',
    emailNote: 'GMT+8 - Qingdao, China',
  },
  fr: {
    cardTitle: 'Coordonnées',
    hqTitle: 'Bureau de Qingdao — Qingdao Vatrad Group',
    hubTitle: 'Centre de production & export',
    emailTitle: 'Demandes générales',
    emailNote: 'GMT+8 - Qingdao, China',
  },
  it: {
    cardTitle: 'Informazioni di contatto',
    hqTitle: 'Ufficio di Qingdao — Qingdao Vatrad Group',
    hubTitle: 'Hub di produzione ed esportazione',
    emailTitle: 'Richieste generali',
    emailNote: 'GMT+8 - Qingdao, China',
  },
  cs: {
    cardTitle: 'Kontaktní informace',
    hqTitle: 'Kancelář v Qingdao — Qingdao Vatrad Group',
    hubTitle: 'Výrobní a exportní centrum',
    emailTitle: 'Obecné dotazy',
    emailNote: 'GMT+8 - Qingdao, China',
  },
};
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/contact.ts';
import { cleanLocalizedText, localizePageTitle, localizePageDescription } from '~/i18n/page-title';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

import cfg from '~/config.yaml';
const branding = (cfg as any)?.branding || {};
import { pageContentData } from '~/i18n/generated/site-data';
import formTextData from '~/data/site/contact-form-text.yaml';
const lang = Astro.params.lang || 'en';
const hub = HUB_TEXT[lang] || HUB_TEXT.en;
setPageContentData(__pageData);
const page = getPageContent(lang, 'contact');
const data = page && Object.keys(page).length > 0 ? page : {};

const ft: any = formTextData ?? {};

function t(record: Record<string, string> | undefined, fallback = ''): string {
  return record?.[lang] || record?.en || fallback;
}

const ht = data.hero_text ?? {};
const form = data.contact_form ?? {};
const other = data.features2_other_ways ?? {};

const fields = (form.fields ?? []).map((f: any) => {
  const trans = (ft.fields ?? []).find((tf: any) => tf.name === f.name);
  if (trans) {
    return {
      ...f,
      label: t(trans.label, f.label),
      placeholder: t(trans.placeholder, f.placeholder ?? ''),
    };
  }
  return f;
});

const countries =
  (pageContentData[`${lang}/site-countries`] || pageContentData['en/site-countries'] || {}).countries?.map(
    (c: any) => ({
      value: c.value,
      label: c.label?.[lang] || c.label?.en || c.value,
    })
  ) ?? [];

const countryCodes =
  (pageContentData[`${lang}/site-countries`] || pageContentData['en/site-countries'] || {}).countries?.map(
    (c: any) => ({
      code: c.tel,
      label: `${c.label?.[lang] || c.label?.en || c.value} ${c.tel}`,
    })
  ) ?? [];

const submitButton = t(ft.submit_button) || form.submit_button || 'Send message';
const successMessage = t(ft.success_message) || form.success_message || 'Thanks!';
const errorMessage = t(ft.error_message) || form.error_message || 'Something went wrong.';
const consentText = t(ft.consent_text) || form.consent?.text;
const consentLinkText = t(ft.consent_link_text) || form.consent?.link_text;

const consent = form.consent
  ? {
      ...form.consent,
      text: consentText,
      link_text: consentLinkText,
    }
  : undefined;

const brandingData: any = branding ?? {};
const resolvedEmailTo =
  (form.email_to && String(form.email_to).trim()) || (brandingData.contact_email_to as string) || '';

const metaDescriptionBase = localizePageDescription(
  page,
  PAGE_DESC[lang]?.description ||
    'Get in touch with Inflatable Pool Factory — sales, support and partnership enquiries reviewed by our team.'
);
// Localized contact descriptions are intentionally short. Extend them with the
// already-published localized form intro rather than padding with the English
// site description, which produced mixed-language snippets.
const formIntro = cleanLocalizedText(form.subtitle);
const metaDescription =
  formIntro && !metaDescriptionBase.includes(formIntro)
    ? `${metaDescriptionBase} ${formIntro}`.trim()
    : metaDescriptionBase;

const metadata = {
  title: localizePageTitle(page, PAGE_META[lang]?.title || `Contact ${SITE.name}`),
  description: metaDescription,
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How can I contact Inflatable Pool Factory?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Email, WhatsApp, or the contact form on this page. Our team reviews each OEM/ODM inquiry and follows up with next steps.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I visit the factory?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. On-site and virtual factory tours available. See our Factory Audit page for preparation details.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the best way to start an OEM project?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use our Request Quotation form to start an OEM project. Include your product requirements, target quantity, and timeline.',
      },
    },
  ],
});
---

<Layout metadata={metadata}>
  <JsonLd
    type="Organization"
    data={{
      name: SITE.name,
      url: 'https://inflatablepoolfactory.com',
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+86-13305324192',
        contactType: 'sales',
        availableLanguage: ['English', 'Chinese', 'Spanish', 'French', 'German', 'Arabic'],
      },
    }}
  />
  <section class="bg-gradient-to-br from-sky-600 via-sky-700 to-blue-800 text-white py-20 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <span class="text-sm font-semibold tracking-widest uppercase text-sky-200">{ht.tagline || 'Contact'}</span>
      <h1 class="mt-4 text-4xl md:text-5xl font-bold">{ht.title || 'Get in Touch'}</h1>
      <p class="mt-4 text-lg text-white/80 max-w-2xl mx-auto">{ht.subtitle || form.subtitle || ''}</p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-16 px-6">
    <div class="grid md:grid-cols-5 gap-10">
      <div class="md:col-span-3">
        <ContactUs
          id={form.id ?? 'form'}
          title={form.title}
          subtitle={form.subtitle}
          emailTo={resolvedEmailTo}
          submitButton={submitButton}
          successMessage={successMessage}
          errorMessage={errorMessage}
          fields={fields}
          consent={consent}
          defaultCountryCode={form.default_country_code ?? '+86'}
          countryCodes={countryCodes}
          countries={countries}
          enableFileUpload
          fileLabel={t(ft.file_upload_label, 'Attachment (optional)')}
          fileHint={t(
            ft.file_upload_hint,
            'Spec sheet, drawing or catalog — PNG, JPG, SVG, WebP, PDF, AI, PSD, DWG, DXF or ZIP, up to 20 MB.'
          )}
        />
      </div>
      <div class="md:col-span-2 space-y-8">
        <div class="bg-white rounded-2xl border border-gray-200 p-6 space-y-6">
          <h3 class="text-lg font-semibold text-gray-900">{data.quick_info?.title || hub.cardTitle}</h3>
          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-sky-50 rounded-lg flex items-center justify-center text-sky-600 shrink-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"
                  ></circle></svg
                >
              </div>
              <div class="min-w-0">
                <p class="font-medium text-gray-900 break-words">{hub.hqTitle}</p>
                <p class="text-sm text-gray-500 break-words">Design, Sales &amp; Billing — Qingdao, Shandong, China</p>
                <p class="text-sm text-gray-500 break-words">+86 13305324192 · info@inflatablepoolfactory.com</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-sky-50 rounded-lg flex items-center justify-center text-sky-600 shrink-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path></svg
                >
              </div>
              <div class="min-w-0">
                <p class="font-medium text-gray-900 break-words">{hub.hubTitle}</p>
                <p class="text-sm text-gray-500 break-words">Qingdao, Shandong, China — FOB Qingdao port</p>
                <p class="text-sm text-gray-500 break-words">+86 13305324192 · factory@inflatablepoolfactory.com</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-sky-50 rounded-lg flex items-center justify-center text-sky-600 shrink-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path><polyline points="22,6 12,13 2,6"></polyline></svg
                >
              </div>
              <div class="min-w-0">
                <p class="font-medium text-gray-900 break-words">{hub.emailTitle}</p>
                <p class="text-sm text-gray-500 break-words">info@inflatablepoolfactory.com</p>
                <p class="text-sm text-gray-500 break-words">{hub.emailNote}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <Features2
        title={other.title}
        tagline={other.tagline}
        columns={other.columns}
        items={other.items}
        isDark={other.isDark}
      />
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
