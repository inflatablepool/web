---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { getCanonical } from '~/utils/permalinks';
import facts from '~/config/facts.json';
import type { MetaData } from '~/types';

export const prerender = true;

const metadata = merge(
  {
    title: `Inflatable Pool OEM/ODM Manufacturing | Inflatable Pool Factory`,
    description: `Develop custom drop-stitch inflatable pools with tailored sizes, colors, branding and packaging. Discuss your OEM or ODM project with our team.`,
    canonical: getCanonical('/oem-odm'),
    robots: { index: true, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;

const crumbs = [{ name: 'Home', href: '/' }, { name: 'OEM / ODM Manufacturing' }];

const capabilities = [
  {
    icon: 'tabler:ruler-2',
    title: 'Custom Sizes & Shapes',
    description:
      'Round pools from Ø 2 m to Ø 10 m, rectangular pools from 2 × 2 × 0.8 m to 6 × 5 × 1.5 m in our standard program — and fully engineered custom dimensions beyond it. Wall thickness options of 10, 15, 20 and 50 cm.',
  },
  {
    icon: 'tabler:palette',
    title: 'Custom Colors & Materials',
    description:
      'Match your brand palette across the drop-stitch walls, rail bands and floor. UV-resistant double-layer PVC in custom colorways; material and compliance documentation is reviewed per project.',
  },
  {
    icon: 'tabler:brand-figma',
    title: 'Logo Printing & Branding',
    description:
      'Silk-screen or heat-transfer logo printing on walls, floors and covers. Optional Oxford-fabric fitted covers and custom hang tags for retail shelves.',
  },
  {
    icon: 'tabler:package',
    title: 'Retail-Ready Packaging',
    description:
      'Custom-printed cartons, color boxes and mailer packaging sized for e-commerce and garden-retail channels. Packed weight and carton dimensions tuned to your logistics.',
  },
  {
    icon: 'tabler:tool',
    title: 'Hardware & Valve Options',
    description:
      'Standard 38 mm filter-pump ports, water shut-off valves, over-inflation safety valves and drain valves — repositioned or resized to your specification.',
  },
  {
    icon: 'tabler:shield-lock',
    title: 'Design Confidentiality',
    description:
      'Design ownership, confidentiality and any exclusivity terms are defined in writing for each project. NDA terms are available on request.',
  },
];

const manufactureCategories = [
  {
    title: 'Rectangular Drop-Stitch Pools',
    description:
      'Straight-sided pools for family swimming and larger outdoor spaces, available in standard sizes and project-specific dimensions.',
    href: '/products/rectangular-drop-stitch-pool',
  },
  {
    title: 'Round Drop-Stitch Pools',
    description:
      'Classic round pools in blue or grey finishes, with optional fitted covers and branding options for retail or commercial programs.',
    href: '/products/round-blue-drop-stitch-pool',
  },
  {
    title: 'SPA & Hot Tub Models',
    description:
      'Round and square SPA tubs with built-in seats and insulated bottoms for soaking applications. External heating and filtration are specified separately.',
    href: '/products/hot-tub-round',
  },
  {
    title: 'Covers, Accessories & Packaging',
    description:
      'Fitted covers, pumps, repair kits, valves, cartons and retail packaging can be specified alongside your pool order.',
    href: '/products/specs',
  },
];

const oemVsOdm = [
  {
    label: 'Product specification',
    oem: 'You provide approved drawings, a specification or a reference sample.',
    odm: 'You share the target market and requirements; we review whether a standard platform, modification or development scope fits.',
  },
  {
    label: 'Design responsibility',
    oem: 'Your design; we manufacture to the agreed specification.',
    odm: 'Any design, engineering or development work is defined in writing before quotation and production.',
  },
  {
    label: 'Branding & packaging',
    oem: 'Logo, colors, covers and packaging are specified in the approved brief.',
    odm: 'Branding and packaging can be included where they fall within the agreed project scope.',
  },
  {
    label: 'Best suited for',
    oem: 'Buyers with a defined product or an existing design.',
    odm: 'Buyers who need a modified platform or want to discuss a development project.',
  },
];

const buyerFaqs = [
  {
    question: 'Can you manufacture to our drawings?',
    answer:
      'Share your drawings, reference sample or target specification. We review the requirement, confirm whether the project fits an OEM or ODM path, and identify any technical details needed before quoting.',
  },
  {
    question: 'What determines MOQ and production lead time?',
    answer:
      'MOQ and production lead time depend on the product platform, customization level, order volume and production season. Final terms are confirmed in your project quotation.',
  },
  {
    question: 'What is the difference between OEM and ODM here?',
    answer:
      'OEM means we manufacture to your approved specification. ODM means we review a product requirement and confirm whether an existing platform or a development scope can meet it. The exact scope is defined in writing before work begins.',
  },
  {
    question: 'What should we prepare before requesting a quote?',
    answer:
      'Product type or reference product, target dimensions, material or performance requirements, logo and packaging requirements, estimated quantity, target market and expected delivery date.',
  },
];

const commercialTerms = [
  {
    title: 'Minimum order quantities',
    body: 'MOQ depends on the product platform, customization level, packaging and order volume. We confirm the applicable MOQ for your project in the quotation.',
  },
  {
    title: 'Sample development lead time',
    body: 'Sample timing depends on the specification, materials and any new tooling. We confirm the sample milestones in the project schedule.',
  },
  {
    title: 'Mass production lead time',
    body: 'Production timing depends on the confirmed specification, order volume and production season. We confirm the delivery schedule in the quotation.',
  },
  {
    title: 'Quality assurance standard',
    body: 'Pressure and leak-test requirements are agreed per product and project. We confirm the test method, duration and acceptance criteria in the production specification.',
  },
];

const quoteChecklist = [
  'Product type or reference product: rectangular, round, SPA or a custom configuration.',
  'Target dimensions: length × width × outer wall height (or internal water depth goal).',
  'Estimated order quantity: initial sample request plus projected mass production volume.',
  'Branding requirements: number of logo colors, logo placement locations, and preferred EVA deck pad texture.',
  'Target destination and delivery terms: FOB port, CIF, or DDP destination address.',
  'Target retail or commercial launch date: your required delivery window.',
  'Required compliance documentation: the regional standards and declarations your market requires. We confirm which requirements can be supported for the specific product and project.',
];

const process = [
  {
    step: '1',
    title: 'Send Your RFQ',
    description:
      'Share drawings, reference photos or target specs — or pick a starting point from our 48-SKU standard catalog.',
  },
  {
    step: '2',
    title: 'Engineering & Quote',
    description:
      'We confirm dimensions, materials, wall thickness and branding, then quote FOB Qingdao with MOQ and lead time.',
  },
  {
    step: '3',
    title: 'Sample Approval',
    description:
      'Sample requirements, approval criteria and milestones are confirmed against the agreed specification before mass production.',
  },
  {
    step: '4',
    title: 'Mass Production',
    description: 'CNC cutting, heat-welding and assembly at our Qingdao factory with inline seam and valve inspection.',
  },
  {
    step: '5',
    title: 'QC & Shipping',
    description:
      'Pressure and leak-test requirements are confirmed in the approved production specification before deflating, cleaning and container loading.',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-4 md:px-6 pt-12 md:pt-16 pb-10 mx-auto max-w-6xl">
    <header class="mb-10 md:mb-12 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
        OEM / ODM Manufacturing
      </p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Custom Inflatable Pool OEM/ODM Manufacturing for Your Brand
      </h1>
      <p class="mt-4 text-xl text-gray-500 dark:text-slate-400 font-medium">
        We support OEM and ODM projects for brands, importers, retailers and commercial buyers — from standard
        drop-stitch platforms with your branding to project-specific sizes, covers and packaging. Share your
        requirements and we will confirm the appropriate route before quotation.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/request-quotation"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-slate-700 text-white font-semibold rounded-full hover:bg-gray-800 dark:hover:bg-slate-600 transition-all text-sm"
        >
          <Icon name="tabler:file-invoice" class="w-4 h-4" /> Request an OEM/ODM Quote
        </a>
        <a
          href="/products/specs"
          class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-slate-600 font-semibold rounded-full hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm"
        >
          <Icon name="tabler:table" class="w-4 h-4" /> Standard Catalog & Prices
        </a>
      </div>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-14">
      {
        capabilities.map((c) => (
          <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
            <span class="mb-3 flex w-10 h-10 items-center justify-center rounded-xl bg-sky-100 dark:bg-sky-900/50 text-primary dark:text-sky-300">
              <Icon name={c.icon} class="w-5 h-5" />
            </span>
            <h2 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1.5">{c.title}</h2>
            <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{c.description}</p>
          </div>
        ))
      }
    </div>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-2">What We Manufacture</h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5 max-w-2xl">
        Our core program covers drop-stitch pools and SPA tubs. Use the standard collections as a starting point, or
        discuss a project-specific configuration with our team.
      </p>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          manufactureCategories.map((category) => (
            <a
              href={category.href}
              class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700 hover:border-sky-300 dark:hover:border-sky-700 transition-colors"
            >
              <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1.5">{category.title}</h3>
              <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{category.description}</p>
              <span class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-sky-600 dark:text-sky-400">
                View product range <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" />
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">
        How an OEM/ODM Project Runs
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5">
        From first drawing to container loading, a typical custom project follows five controlled steps. Sample terms
        and quantity pricing are confirmed per project in the quotation, FOB Qingdao.
      </p>
      <ol class="grid md:grid-cols-5 gap-3">
        {
          process.map((p) => (
            <li class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <span class="mb-2 flex w-8 h-8 items-center justify-center rounded-full bg-sky-100 dark:bg-sky-900/50 text-sky-700 dark:text-sky-300 text-sm font-bold">
                {p.step}
              </span>
              <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1">{p.title}</h3>
              <p class="text-xs text-gray-600 dark:text-slate-400 leading-relaxed">{p.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-2">OEM vs. ODM</h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5 max-w-2xl">
        OEM and ODM are different starting points, not interchangeable labels. We confirm the applicable path and the
        design/development boundary in writing before quotation.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-gray-100 dark:border-slate-700">
        <table class="w-full text-sm min-w-[640px]">
          <thead>
            <tr class="bg-gray-50 dark:bg-slate-800/60 text-left">
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Project element</th>
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">OEM</th>
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">ODM</th>
            </tr>
          </thead>
          <tbody>
            {
              oemVsOdm.map((row, index) => (
                <tr class={index % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-800/40'}>
                  <td class="px-4 py-3 font-medium text-gray-900 dark:text-slate-200 align-top">{row.label}</td>
                  <td class="px-4 py-3 text-gray-600 dark:text-slate-400 align-top leading-relaxed">{row.oem}</td>
                  <td class="px-4 py-3 text-gray-600 dark:text-slate-400 align-top leading-relaxed">{row.odm}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-14 grid md:grid-cols-2 gap-4">
      <div class="p-6 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-2">What You Can Customize</h2>
        <ul class="space-y-1.5 text-sm text-gray-600 dark:text-slate-400">
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Pool dimensions,
            wall thickness (10/15/20/50 cm) and height
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Fabric colorways,
            rail-band colors and floor patterns
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Logo printing,
            fitted covers, built-in seats, 5 mm insulated bottoms
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Valve placement,
            38 mm filter ports, drain and safety valves
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Carton artwork,
            color boxes, manuals and hang tags
          </li>
        </ul>
      </div>
      <div class="p-6 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-2">Specification Planning</h2>
        <ul class="space-y-1.5 text-sm text-gray-600 dark:text-slate-400">
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Operating pressure
            and wall rigidity are defined in the approved product specification.
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" />
            Pressure-relief valve settings and maximum tolerances are confirmed for each model.
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Pressure and
            leak-test method, hold time and acceptance criteria are agreed per project.
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Material and
            UV requirements are reviewed against the target market; compliance documentation is confirmed per project.
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Pump, repair-kit
            and accessory inclusions are confirmed in the quotation and packing list.
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-2">
        Commercial Terms: MOQ, Lead Times &amp; Sample Terms
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5 max-w-2xl">
        Project-specific commercial terms are confirmed in your quotation based on product scope, customization and
        season.
      </p>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          commercialTerms.map((t) => (
            <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1.5">{t.title}</h3>
              <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{t.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-2">
        Checklist: What We Need for a Precise Custom Quote
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5 max-w-2xl">
        Prepare these details before submitting your inquiry so we can review your requirements for an accurate OEM/ODM
        quote.
      </p>
      <ul class="grid md:grid-cols-2 gap-3">
        {
          quoteChecklist.map((item) => (
            <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <Icon name="tabler:square-check" class="w-5 h-5 mt-0.5 text-primary dark:text-sky-400 shrink-0" />
              <span class="text-sm text-gray-600 dark:text-slate-300 leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-2">OEM/ODM Buyer FAQ</h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5 max-w-2xl">
        Direct answers to the questions buyers ask before sharing drawings or requesting samples.
      </p>
      <div class="space-y-3">
        {
          buyerFaqs.map((faq) => (
            <details class="group rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 open:shadow-sm transition-shadow">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer text-sm font-semibold text-gray-900 dark:text-slate-200 list-none">
                {faq.question}
                <span class="shrink-0 ml-2 text-gray-300 dark:text-slate-600 group-open:rotate-180 transition-transform text-xs">
                  &#9660;
                </span>
              </summary>
              <div class="px-5 pb-4 text-sm text-gray-600 dark:text-slate-400 leading-relaxed border-t border-gray-100 dark:border-slate-700 pt-3 mt-0">
                {faq.answer}
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">
        Company &amp; Manufacturing Entity
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-4 max-w-3xl">
        Brand, operating team, legal entity and production base — stated the same way across our B2B pages.
      </p>
      <dl class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {
          [
            { term: 'Brand', detail: facts.brand.name },
            { term: 'Operating team', detail: facts.brand.operator },
            { term: 'Legal entity', detail: facts.brand.legalName },
            { term: 'Production base', detail: `${facts.factory.city}, ${facts.factory.province}, China` },
            { term: 'Contracting entity', detail: 'Stated in your quotation and order documents' },
            {
              term: 'Quality & after-sales',
              detail: 'Coordinated by the Inflatable Pool Team; claim and warranty terms are set out in our Terms',
            },
          ].map((item) => (
            <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800/50 p-4">
              <dt class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                {item.term}
              </dt>
              <dd class="mt-1 text-sm font-medium text-gray-900 dark:text-slate-200">{item.detail}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 text-sm text-gray-500 dark:text-slate-400">
        Read more on the <a href="/about#company" class="text-primary dark:text-sky-400 hover:underline">About page</a>.
      </p>
    </section>

    <section class="mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-3">Related B2B Pages</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a
          href="/private-label"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Private Label Pools</a
        >
        <a
          href="/wholesale"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Wholesale Program</a
        >
        <a
          href="/manufacturing"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Manufacturing Process</a
        >
        <a
          href="/quality-control"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Quality Control</a
        >
      </div>
    </section>

    <section class="mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-3">Guides for Buyers</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a
          href="/guides/how-to-choose-a-drop-stitch-pool-manufacturer"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Choosing a Manufacturer</a
        >
        <a
          href="/guides/oem-vs-odm-inflatable-pools"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >OEM vs ODM</a
        >
        <a
          href="/guides/private-label-inflatable-pool-buyers-guide"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Private Label Guide</a
        >
      </div>
    </section>
  </section>

  <section class="sr-only" data-ai-block="oem-odm" aria-hidden="true">
    <p>
      Inflatable Pool Factory offers OEM/ODM inflatable pool manufacturing at its Qingdao factory: custom sizes (round Ø
      2–10 m, rectangular up to 6 × 5 × 1.5 m and beyond), wall thickness options of 10/15/20/50 cm, custom colors, logo
      printing, Oxford-fabric covers, built-in seats, 5 mm insulated bottoms, custom valve and 38 mm filter-port
      placement, and retail-ready packaging. Five-step project flow: RFQ, engineering and FOB Qingdao quote, sample
      approval, mass production, and QC against the approved specification. MOQ, sample timing, production lead time and
      pressure-test requirements are confirmed in the project quotation and production specification. Material and
      compliance documentation is reviewed against the requirements of the target market. NDA terms are available on
      request.
    </p>
  </section>
</Layout>
