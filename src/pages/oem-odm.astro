---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import type { MetaData } from '~/types';

export const prerender = true;

const metadata = merge(
  {
    title: `Inflatable Pool OEM/ODM Manufacturer | ${SITE.name}`,
    description: `OEM/ODM inflatable pool manufacturing by Inflatable Pool Factory — custom sizes, colors, logo printing, covers and retail packaging. 48 standard SKUs plus full custom engineering. Request a quote.`,
    canonical: getCanonical('/oem-odm'),
    robots: { index: true, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;

const crumbs = [{ name: 'Home', href: '/' }, { name: 'OEM / ODM Manufacturing' }];

const capabilities = [
  {
    icon: 'tabler:ruler-2',
    title: 'Custom Sizes & Shapes',
    description:
      'Round pools from Ø 2 m to Ø 10 m, rectangular pools from 2 × 2 × 0.8 m to 6 × 5 × 1.5 m in our standard program — and fully engineered custom dimensions beyond it. Wall thickness options of 10, 15, 20 and 50 cm.',
  },
  {
    icon: 'tabler:palette',
    title: 'Custom Colors & Materials',
    description:
      'Match your brand palette across the drop-stitch walls, rail bands and floor. UV-resistant, REACH-compliant double-layer PVC fabric in custom colorways.',
  },
  {
    icon: 'tabler:brand-figma',
    title: 'Logo Printing & Branding',
    description:
      'Silk-screen or heat-transfer logo printing on walls, floors and covers. Optional Oxford-fabric fitted covers and custom hang tags for retail shelves.',
  },
  {
    icon: 'tabler:package',
    title: 'Retail-Ready Packaging',
    description:
      'Custom-printed cartons, color boxes and mailer packaging sized for e-commerce and garden-retail channels. Packed weight and carton dimensions tuned to your logistics.',
  },
  {
    icon: 'tabler:tool',
    title: 'Hardware & Valve Options',
    description:
      'Standard 38 mm filter-pump ports, water shut-off valves, over-inflation safety valves and drain valves — repositioned or resized to your specification.',
  },
  {
    icon: 'tabler:shield-lock',
    title: 'Design Confidentiality',
    description:
      'Your drawings, molds and colorways stay yours. We never sell a customer-exclusive design to another buyer, and NDA agreements are welcome.',
  },
];

const commercialTerms = [
  {
    title: 'Minimum order quantities',
    body: 'Custom branding on existing platforms typically starts at 50–100 units per model; fully custom geometric molds typically start at 100–200 units depending on raw material yield. Final MOQs are confirmed per project scope.',
  },
  {
    title: 'Sample development lead time',
    body: '15–20 business days following technical drawing sign-off and sample deposit confirmation.',
  },
  {
    title: 'Mass production lead time',
    body: '30–45 calendar days depending on seasonal production schedules and raw material availability.',
  },
  {
    title: 'Quality assurance standard',
    body: 'Every drop-stitch hull is 100% pressure-tested — a 24-hour hold at 1.25x rated pressure — before proceeding to final packaging.',
  },
];

const quoteChecklist = [
  'Target dimensions: length × width × outer wall height (or internal water depth goal).',
  'Estimated order quantity: initial sample request plus projected mass production volume.',
  'Branding requirements: number of logo colors, logo placement locations, and preferred EVA deck pad texture.',
  'Target destination and delivery terms: FOB port, CIF, or DDP destination address.',
  'Target retail or commercial launch date: your required delivery window.',
  'Required compliance documentation: regional standards you need supported (we work to EN 16582-1, ASTM F2666, REACH, and RoHS baselines).',
];

const process = [
  {
    step: '1',
    title: 'Send Your RFQ',
    description:
      'Share drawings, reference photos or target specs — or pick a starting point from our 48-SKU standard catalog.',
  },
  {
    step: '2',
    title: 'Engineering & Quote',
    description:
      'We confirm dimensions, materials, wall thickness and branding, then quote FOB Qingdao with MOQ and lead time.',
  },
  {
    step: '3',
    title: 'Sample Approval',
    description:
      'A pre-production sample is manufactured and pressure-tested for your approval before the order is released.',
  },
  {
    step: '4',
    title: 'Mass Production',
    description: 'CNC cutting, heat-welding and assembly at our Qingdao factory with inline seam and valve inspection.',
  },
  {
    step: '5',
    title: 'QC & Shipping',
    description: 'Every unit passes a 24–48 hour pressure-drop test before deflating, cleaning and container loading.',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-4 md:px-6 pt-12 md:pt-16 pb-10 mx-auto max-w-6xl">
    <header class="mb-10 md:mb-12 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
        OEM / ODM Manufacturing
      </p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Custom Inflatable Pools for Brands &amp; Business Partners
      </h1>
      <p class="mt-4 text-xl text-gray-500 dark:text-slate-400 font-medium">
        Inflatable Pool Factory manufactures drop-stitch inflatable pools to your specification — custom sizes, colors,
        logo printing, covers and retail packaging, produced at our Qingdao factory and shipped worldwide.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/request-quotation"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-slate-700 text-white font-semibold rounded-full hover:bg-gray-800 dark:hover:bg-slate-600 transition-all text-sm"
        >
          <Icon name="tabler:file-invoice" class="w-4 h-4" /> Request an OEM Quote
        </a>
        <a
          href="/products/specs"
          class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-slate-600 font-semibold rounded-full hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm"
        >
          <Icon name="tabler:table" class="w-4 h-4" /> Standard Catalog & Prices
        </a>
      </div>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-14">
      {
        capabilities.map((c) => (
          <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
            <span class="mb-3 flex w-10 h-10 items-center justify-center rounded-xl bg-sky-100 dark:bg-sky-900/50 text-primary dark:text-sky-300">
              <Icon name={c.icon} class="w-5 h-5" />
            </span>
            <h2 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1.5">{c.title}</h2>
            <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{c.description}</p>
          </div>
        ))
      }
    </div>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">
        How an OEM/ODM Project Runs
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5">
        From first drawing to container loading, a typical custom project follows five controlled steps. Sample orders
        start from a single piece; standard pricing is based on 20 pcs per item, FOB Qingdao.
      </p>
      <ol class="grid md:grid-cols-5 gap-3">
        {
          process.map((p) => (
            <li class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <span class="mb-2 flex w-8 h-8 items-center justify-center rounded-full bg-sky-100 dark:bg-sky-900/50 text-sky-700 dark:text-sky-300 text-sm font-bold">
                {p.step}
              </span>
              <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1">{p.title}</h3>
              <p class="text-xs text-gray-600 dark:text-slate-400 leading-relaxed">{p.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mb-14 grid md:grid-cols-2 gap-4">
      <div class="p-6 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-2">What You Can Customize</h2>
        <ul class="space-y-1.5 text-sm text-gray-600 dark:text-slate-400">
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Pool dimensions,
            wall thickness (10/15/20/50 cm) and height
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Fabric colorways,
            rail-band colors and floor patterns
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Logo printing,
            fitted covers, built-in seats, 5 mm insulated bottoms
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Valve placement,
            38 mm filter ports, drain and safety valves
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Carton artwork,
            color boxes, manuals and hang tags
          </li>
        </ul>
      </div>
      <div class="p-6 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
        <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-2">Engineering Baseline</h2>
        <ul class="space-y-1.5 text-sm text-gray-600 dark:text-slate-400">
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> 4–5 PSI recommended
            operating pressure, rigid walls
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> Pressure-relief
            valve auto-releases above 6 PSI; 8 PSI maximum tolerance
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> 24–48 hour pressure-drop
            leak test on every production unit
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> REACH-compliant,
            UV-resistant double-layer drop-stitch PVC
          </li>
          <li class="flex gap-2">
            <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0" /> 1000W electric
            air pump and repair kit included as standard
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-2">
        Commercial Terms: MOQ, Lead Times &amp; Sample Terms
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5 max-w-2xl">
        Typical commercial terms for custom projects — exact figures are confirmed in your quotation based on project
        scope and season.
      </p>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          commercialTerms.map((t) => (
            <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1.5">{t.title}</h3>
              <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{t.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-2">
        Checklist: What We Need for a Precise Custom Quote
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-5 max-w-2xl">
        Prepare these details before submitting your inquiry to receive a fast, accurate OEM/ODM quote.
      </p>
      <ul class="grid md:grid-cols-2 gap-3">
        {
          quoteChecklist.map((item) => (
            <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
              <Icon name="tabler:square-check" class="w-5 h-5 mt-0.5 text-primary dark:text-sky-400 shrink-0" />
              <span class="text-sm text-gray-600 dark:text-slate-300 leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-3">Related B2B Pages</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a
          href="/private-label"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Private Label Pools</a
        >
        <a
          href="/wholesale"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Wholesale Program</a
        >
        <a
          href="/manufacturing"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Manufacturing Process</a
        >
        <a
          href="/quality-control"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Quality Control</a
        >
      </div>
    </section>

    <section class="mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-3">Guides for Buyers</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a
          href="/guides/how-to-choose-a-drop-stitch-pool-manufacturer"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Choosing a Manufacturer</a
        >
        <a
          href="/guides/oem-vs-odm-inflatable-pools"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >OEM vs ODM</a
        >
        <a
          href="/guides/private-label-inflatable-pool-buyers-guide"
          class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
          >Private Label Guide</a
        >
      </div>
    </section>
  </section>

  <section class="sr-only" data-ai-block="oem-odm" aria-hidden="true">
    <p>
      Inflatable Pool Factory offers OEM/ODM inflatable pool manufacturing at its Qingdao factory: custom sizes (round Ø
      2–10 m, rectangular up to 6 × 5 × 1.5 m and beyond), wall thickness options of 10/15/20/50 cm, custom colors, logo
      printing, Oxford-fabric covers, built-in seats, 5 mm insulated bottoms, custom valve and 38 mm filter-port
      placement, and retail-ready packaging. Five-step project flow: RFQ, engineering and FOB Qingdao quote, sample
      approval, mass production, and QC with a 24–48 hour pressure-drop test. Engineering baseline: 4–5 PSI operating
      pressure, pressure-relief valve above 6 PSI, 8 PSI maximum, REACH-compliant UV-resistant drop-stitch PVC. Samples
      from 1 piece; standard price basis 20 pcs per item. Design confidentiality guaranteed; NDA welcome.
    </p>
  </section>
</Layout>
