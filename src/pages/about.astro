---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';
import { SITE } from 'astrowind:config';
import { toAssetUrl } from '~/utils/images';
import facts from '~/config/facts.json';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import { pageContentData } from '~/i18n/generated/site-data';
import __pageData from '~/i18n/generated/pages/about.ts';
import { getUiForLang } from '~/i18n/generated/ui-all';

const lang = 'en';
const t = (key: string) => getUiForLang(lang)?.[key] || '';

setPageContentData(__pageData);
const page = getPageContent(lang, 'about');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const wwb = page.features3_what_we_build ?? {};
const more = page.features3_more ?? {};
const values = page.steps2_values ?? {};
const milestones = page.steps2_milestones ?? {};
const locations = page.features2_locations ?? {};

const brandTagline = page.brand_hub_tagline ?? 'Brand';
const brandTitle = page.brand_hub_title ?? 'Explore Our Brand';
const brandSubtitle = page.brand_hub_subtitle ?? '';
const brandCards = page.brand_hub_cards ?? [];

const about = pageContentData[`${lang}/site-about`] || pageContentData['en/site-about'] || {};
const origin = about.origin || {};
const philosophy = about.philosophy || {};
const design = about.design || {};

const metadata = {
  title: `About ${SITE.name} & ${facts.brand.legalName}`,
  description: `Drop stitch inflatable pool brand by the Inflatable Pool Team at ${facts.brand.legalName}. Learn who we are, what we build and how we work with B2B buyers.`,
  openGraph: {
    type: 'website',
    ...(hero?.image?.src ? { images: [{ url: hero.image.src, width: 1200, height: 630 }] } : {}),
  },
};

const crumbs = [{ name: t('nav.home') || 'Home', href: '/' }, { name: 'About' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />

  <Stats title={stats.title} stats={stats.stats} />

  <!-- Entity clarity for buyers, search engines and AI systems. -->
  <section class="max-w-6xl mx-auto py-16 px-6" id="company">
    <div class="grid md:grid-cols-2 gap-10 items-start">
      <div>
        <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">Company &amp; Manufacturing Entity</span>
        <h2 class="mt-4 text-3xl md:text-4xl font-semibold text-gray-900 dark:text-slate-100">
          Who is behind Inflatable Pool Factory?
        </h2>
        <p class="mt-5 text-gray-600 dark:text-slate-400 leading-relaxed">
          Inflatable Pool Factory is the pool brand of the Inflatable Pool Team at {facts.brand.legalName}. The team
          works from Qingdao, Shandong, China, supporting sales, partner inquiries and order coordination for
          drop-stitch inflatable pools.
        </p>
        <p class="mt-4 text-gray-600 dark:text-slate-400 leading-relaxed">
          We work with retail customers and B2B partners, including brands, importers, distributors, retailers and
          commercial projects. For each order, the contracting entity, production location and shipping terms are stated
          in the quotation.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm">
          <a href="/oem-odm" class="font-semibold text-primary dark:text-sky-400 hover:underline"
            >OEM / ODM manufacturing</a
          >
          <a href="/manufacturing" class="font-semibold text-primary dark:text-sky-400 hover:underline"
            >Manufacturing process</a
          >
          <a href="/contact" class="font-semibold text-primary dark:text-sky-400 hover:underline">Contact the team</a>
        </div>
      </div>
      <dl class="grid sm:grid-cols-2 gap-4">
        {
          [
            { term: 'Brand', detail: facts.brand.name },
            { term: 'Operated by', detail: facts.brand.operator },
            { term: 'Legal entity', detail: facts.brand.legalName },
            { term: 'Location', detail: `${facts.office.city}, ${facts.office.province}, China` },
            { term: 'Production base', detail: `${facts.factory.city}, ${facts.factory.province}, China` },
            { term: 'Contracting entity', detail: 'Stated in your quotation and order documents' },
            {
              term: 'Quality & after-sales',
              detail: 'Coordinated by the Inflatable Pool Team; claim and warranty terms are set out in our Terms',
            },
            { term: 'Business focus', detail: 'Drop-stitch pool manufacturing, OEM/ODM and private label' },
            { term: 'Website', detail: 'inflatablepoolfactory.com' },
            { term: 'Email', detail: facts.contact.email },
            { term: 'Phone', detail: facts.contact.primaryPhone },
          ].map((item) => (
            <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800/50 p-4">
              <dt class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                {item.term}
              </dt>
              <dd class="mt-1 text-sm font-medium text-gray-900 dark:text-slate-200 break-words">{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Origin Story -->
  <section class="max-w-6xl mx-auto py-24 px-6">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div>
        <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{origin.tagline || 'Our Origin'}</span>
        <h2
          class="mt-4 text-3xl md:text-4xl font-semibold text-gray-900 dark:text-slate-100 leading-tight"
          set:html={origin.heading || 'Built for summer,<br /><span class="text-sky-600">engineered to last</span>'}
        />
        <div class="mt-8 space-y-5 text-gray-600 dark:text-slate-400 leading-relaxed">
          {(origin.paragraphs || []).map((p: string) => <p set:html={p} />)}
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden bg-gray-100 dark:bg-slate-800 aspect-[4/3]">
        <img
          src={toAssetUrl(origin.image || '/images/pools/rectangular-pool-1.jpg')}
          alt={origin.image_alt || 'Inflatable Pool Factory drop stitch pool'}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="bg-gray-50 dark:bg-slate-900/50 py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-sm font-medium text-sky-600 tracking-wide uppercase"
          >{philosophy.tagline || 'Our Philosophy'}</span
        >
        <h2 class="mt-4 text-3xl md:text-4xl font-semibold text-gray-900 dark:text-slate-100">
          {philosophy.heading || 'Simple, durable, honest'}
        </h2>
        <p class="mt-4 text-lg text-gray-500 dark:text-slate-400">{philosophy.description || ''}</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {
          (philosophy.cards || []).map((card: any) => (
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-8 border border-gray-200 dark:border-slate-700">
              <div class="w-14 h-14 bg-blue-50 dark:bg-blue-900/30 rounded-xl flex items-center justify-center text-2xl">
                {card.emoji || ''}
              </div>
              <h3 class="mt-5 text-lg font-semibold text-gray-900 dark:text-slate-100">{card.title || ''}</h3>
              <p class="mt-3 text-gray-500 dark:text-slate-400 text-sm leading-relaxed">{card.description || ''}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Design Philosophy -->
  <section class="max-w-6xl mx-auto py-24 px-6">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div class="rounded-2xl overflow-hidden bg-gray-100 dark:bg-slate-800 aspect-[4/3] order-last md:order-first">
        <img
          src={toAssetUrl(design.image || '/images/pools/round-grey-pool-1.webp')}
          alt={design.image_alt || 'Inflatable Pool Factory pool design'}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <span class="text-sm font-medium text-sky-600 tracking-wide uppercase"
          >{design.tagline || 'Design Philosophy'}</span
        >
        <h2
          class="mt-4 text-3xl md:text-4xl font-semibold text-gray-900 dark:text-slate-100 leading-tight"
          set:html={design.heading || 'Designed from the<br /><span class="text-sky-600">water outward</span>'}
        />
        <div class="mt-8 space-y-5 text-gray-600 dark:text-slate-400 leading-relaxed">
          {(design.paragraphs || []).map((p: string) => <p set:html={p} />)}
        </div>
        <div class="mt-8 grid grid-cols-3 gap-4">
          {
            (design.stats || []).map((s: any) => (
              <div class="text-center p-4 bg-gray-50 dark:bg-slate-800 rounded-xl">
                <div class="text-2xl font-bold text-sky-600">{s.value || ''}</div>
                <div class="text-xs text-gray-500 dark:text-slate-400 mt-1" set:html={s.label || ''} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <TrustBadges title="Quality & documentation" />

  <Features3
    title={wwb.title}
    subtitle={wwb.subtitle}
    columns={wwb.columns}
    isBeforeContent={wwb.isBeforeContent}
    items={wwb.items}
  />

  <Features3 columns={more.columns} isAfterContent={more.isAfterContent} items={more.items} image={more.image} />

  <Steps2 title={values.title} subtitle={values.subtitle} items={values.items} />

  <Steps2
    title={milestones.title}
    subtitle={milestones.subtitle}
    isReversed={milestones.isReversed}
    items={milestones.items}
  />

  <Features2 title={locations.title} tagline={locations.tagline} columns={locations.columns} items={locations.items} />

  <!-- Products Hub -->
  <section class="px-6 sm:px-6 py-20 mx-auto max-w-6xl bg-gray-50 dark:bg-gray-900 rounded-2xl">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">{brandTagline}</p>
      <h2 class="mt-2 text-3xl font-bold">{brandTitle}</h2>
      <p class="mt-3 text-muted max-w-2xl mx-auto">{brandSubtitle}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {
        brandCards.map((card: any) => (
          <a
            href={card.link}
            class="p-6 rounded-xl bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 hover:shadow-md transition-shadow"
          >
            <h3 class="text-lg font-bold">{card.title}</h3>
            <p class="mt-2 text-sm text-muted leading-relaxed">{card.desc}</p>
            <span class="mt-3 inline-block text-sm font-semibold text-primary">{card.link_label}</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
