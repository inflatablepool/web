---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import ExpertCitation from '~/components/common/ExpertCitation.astro';
import { SITE } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import { procurementGuides, GUIDE_CLUSTER_LABELS } from '~/data/procurement-guides';
import { guides } from '~/data/guides';
import facts from '~/config/facts.json';
import type { MetaData } from '~/types';

export const prerender = true;

export function getStaticPaths() {
  return [
    ...procurementGuides.map((g) => ({ params: { slug: g.slug } })),
    ...guides.map((g) => ({ params: { slug: g.slug } })),
  ];
}

interface ArticleSectionView {
  id: string;
  heading: string;
  paragraphs: string[];
  bullets: string[];
}

interface ArticleView {
  slug: string;
  kind: 'procurement' | 'consumer';
  clusterLabel: string;
  title: string;
  description: string;
  publishDate: string;
  updateDate: string;
  readMinutes: number;
  audience: string;
  tldr: string;
  sections: ArticleSectionView[];
  faq: { q: string; a: string }[];
  related: { label: string; href: string }[];
}

const slug = Astro.params.slug as string;

const procurement = procurementGuides.find((g) => g.slug === slug);
const consumer = guides.find((g) => g.slug === slug);

function toId(heading: string, index: number): string {
  const base = heading
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  return base || `section-${index + 1}`;
}

let article: ArticleView;

if (procurement) {
  article = {
    slug: procurement.slug,
    kind: 'procurement',
    clusterLabel: GUIDE_CLUSTER_LABELS[procurement.cluster],
    title: procurement.title,
    description: procurement.description,
    publishDate: procurement.publishDate,
    updateDate: procurement.updateDate,
    readMinutes: procurement.readMinutes,
    audience: procurement.audience,
    tldr: procurement.tldr,
    sections: procurement.sections.map((s, i) => ({
      id: toId(s.heading, i),
      heading: s.heading,
      paragraphs: s.paragraphs,
      bullets: s.bullets ?? [],
    })),
    faq: procurement.faq,
    related: procurement.related,
  };
} else if (consumer) {
  article = {
    slug: consumer.slug,
    kind: 'consumer',
    clusterLabel: 'Consumer Guides',
    title: consumer.title,
    description: consumer.description,
    publishDate: '2026-08-01',
    updateDate: '2026-10-16',
    readMinutes: 5,
    audience: consumer.audience,
    tldr: consumer.tldr,
    sections: [
      { heading: 'The Problem', paragraphs: [consumer.problem], bullets: [] },
      { heading: 'The Solution', paragraphs: [consumer.solution], bullets: [] },
      { heading: 'Step by Step', paragraphs: [], bullets: consumer.steps },
    ].map((s, i) => ({ id: toId(s.heading, i), ...s })),
    faq: consumer.faq,
    related: [
      { label: 'All Pool Guides', href: '/guides' },
      { label: 'All Products', href: '/products' },
      { label: 'FAQ', href: '/faq' },
    ],
  };
} else {
  article = {
    slug,
    kind: 'consumer',
    clusterLabel: '',
    title: 'Guide',
    description: '',
    publishDate: '',
    updateDate: '',
    readMinutes: 5,
    audience: '',
    tldr: '',
    sections: [],
    faq: [],
    related: [],
  };
}

const isProcurement = article.kind === 'procurement';

const metadata = merge(
  {
    title: `${isProcurement ? procurementGuides.find((g) => g.slug === slug)?.seoTitle : article.title} | ${SITE.name}`,
    description: article.description,
    canonical: getCanonical(`/guides/${article.slug}`),
    robots: { index: true, follow: true },
    openGraph: { type: 'article' },
  },
  {}
) as MetaData;

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides' }, { name: article.title }];

const formatDate = (iso: string) =>
  iso ? new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-4 md:px-6 pt-12 md:pt-16 mx-auto max-w-6xl">
    <header class="max-w-3xl">
      <nav class="mb-4 text-sm text-gray-500 dark:text-slate-400">
        <a href="/guides" class="hover:text-primary dark:hover:text-sky-400 font-medium">Guides</a>
        <span class="mx-2">/</span>
        <span>{article.clusterLabel}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter font-heading">
        {article.title}
      </h1>
      <p class="mt-4 text-lg text-gray-500 dark:text-slate-400 font-medium">{article.description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-500 dark:text-slate-400">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="tabler:calendar" class="w-4 h-4" /> Published {formatDate(article.publishDate)}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="tabler:refresh" class="w-4 h-4" /> Updated {formatDate(article.updateDate)}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="tabler:clock" class="w-4 h-4" />
          {article.readMinutes} min read
        </span>
      </div>
    </header>
  </section>

  <div class="px-4 md:px-6 pb-16 mx-auto max-w-6xl grid lg:grid-cols-[240px_1fr] gap-10">
    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-3">
          On this page
        </p>
        <nav class="space-y-1.5 border-l border-gray-200 dark:border-slate-700">
          {
            article.sections.map((s) => (
              <a
                href={`#${s.id}`}
                class="block pl-4 py-1 text-sm text-gray-600 dark:text-slate-400 hover:text-primary dark:hover:text-sky-400 border-l-2 border-transparent -ml-px hover:border-primary dark:hover:border-sky-400 transition-colors"
              >
                {s.heading}
              </a>
            ))
          }
          {
            article.faq.length > 0 && (
              <a
                href="#faq"
                class="block pl-4 py-1 text-sm text-gray-600 dark:text-slate-400 hover:text-primary dark:hover:text-sky-400 border-l-2 border-transparent -ml-px hover:border-primary dark:hover:border-sky-400 transition-colors"
              >
                FAQ
              </a>
            )
          }
        </nav>
        {
          isProcurement && (
            <a
              href="/request-quotation"
              class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 dark:bg-slate-700 text-white text-sm font-semibold rounded-full hover:bg-gray-800 dark:hover:bg-slate-600 transition-all"
            >
              <Icon name="tabler:file-invoice" class="w-4 h-4" /> Request a Quote
            </a>
          )
        }
      </div>
    </aside>

    <article class="max-w-3xl">
      <div class="p-5 rounded-2xl bg-sky-50 dark:bg-sky-900/20 border border-sky-100 dark:border-sky-800/50 mb-10">
        <p class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300 mb-2">TL;DR</p>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">{article.tldr}</p>
      </div>

      <ExpertCitation
        author="Inflatable Pool Factory Pool Team"
        reviewer={isProcurement ? facts.founder.name : 'Product & Quality Team'}
        department={isProcurement ? facts.founder.jobTitle : 'Quality & Engineering'}
        datePublished={formatDate(article.publishDate)}
        dateUpdated={formatDate(article.updateDate)}
      />

      <div class="space-y-10">
        {
          article.sections.map((s) => (
            <section id={s.id} class="scroll-mt-24">
              <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-4">{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p class="text-gray-600 dark:text-slate-400 leading-relaxed mb-4">{p}</p>
              ))}
              {s.bullets.length > 0 && (
                <ul class="space-y-2.5">
                  {s.bullets.map((b) => (
                    <li class="flex gap-2.5 text-gray-600 dark:text-slate-400 leading-relaxed">
                      <Icon
                        name="tabler:circle-check"
                        class="w-5 h-5 mt-0.5 text-primary dark:text-sky-400 flex-shrink-0"
                      />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      {
        article.faq.length > 0 && (
          <section id="faq" class="mt-12 scroll-mt-24">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-5">
              Frequently Asked Questions
            </h2>
            <div class="space-y-3">
              {article.faq.map((item) => (
                <details class="bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700 rounded-xl overflow-hidden group">
                  <summary class="px-5 py-4 font-semibold text-gray-900 dark:text-slate-100 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors list-none flex items-center justify-between">
                    <span>{item.q}</span>
                    <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
                  </summary>
                  <div class="px-5 pb-4">
                    <p class="text-gray-600 dark:text-slate-400 leading-relaxed">{item.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )
      }

      {
        isProcurement && (
          <div class="mt-12 p-6 rounded-2xl bg-gray-900 dark:bg-slate-800 text-center">
            <h2 class="text-xl font-bold text-white mb-2">Sourcing drop stitch pools?</h2>
            <p class="text-gray-300 dark:text-slate-300 text-sm mb-5 max-w-xl mx-auto">
              Get an itemized FOB Qingdao quote — pricing on a 20-pc basis, samples from one piece, and a container
              loading plan included.
            </p>
            <a
              href="/request-quotation"
              class="inline-flex items-center gap-2 px-6 py-3 bg-white text-gray-900 font-semibold rounded-full hover:bg-gray-100 transition-all text-sm"
            >
              <Icon name="tabler:file-invoice" class="w-4 h-4" /> Request a Bulk Quote
            </a>
          </div>
        )
      }

      {
        article.related.length > 0 && (
          <section class="mt-10">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-4">
              Related pages
            </h2>
            <div class="flex flex-wrap gap-2 text-sm">
              {article.related.map((r) => (
                <a
                  href={r.href}
                  class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
                >
                  {r.label}
                </a>
              ))}
            </div>
          </section>
        )
      }
    </article>
  </div>

  <JsonLd
    type="Article"
    article={{
      headline: article.title,
      description: article.description,
      datePublished: article.publishDate,
      dateModified: article.updateDate,
      authorName: 'Inflatable Pool Factory Team',
      editorName: isProcurement ? facts.founder.name : undefined,
    }}
    data={{ url: `${SITE.site}/guides/${article.slug}` }}
  />
  {article.faq.length > 0 && <JsonLd type="FAQPage" faqs={article.faq} />}
</Layout>
