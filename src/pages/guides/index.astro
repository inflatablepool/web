---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import { procurementGuides, GUIDE_CLUSTER_LABELS } from '~/data/procurement-guides';
import { guides } from '~/data/guides';
import type { MetaData } from '~/types';
import type { GuideCluster } from '~/data/procurement-guides';

export const prerender = true;

const metadata = merge(
  {
    title: `Procurement & Technical Guides — Drop Stitch Pool Sourcing | ${SITE.name}`,
    description:
      'B2B guides for drop stitch pool buyers: choosing a manufacturer, OEM vs ODM, private label, pressure testing, FOB pricing and container loading.',
    canonical: getCanonical('/guides'),
    robots: { index: true, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guides' }];

const clusterOrder: GuideCluster[] = ['factory-oem', 'materials-quality', 'price-logistics'];

const clusterIcons: Record<GuideCluster, string> = {
  'factory-oem': 'tabler:building-factory',
  'materials-quality': 'tabler:shield-check',
  'price-logistics': 'tabler:ship',
};

const clusterDescriptions: Record<GuideCluster, string> = {
  'factory-oem':
    'How to evaluate manufacturers, choose between manufacturing models, and launch a brand on proven designs.',
  'materials-quality':
    'The engineering and quality standards behind drop stitch pools — pressure specs, testing and inspection.',
  'price-logistics': 'Real FOB pricing, landed-cost math and container planning for wholesale pool programs.',
};

const clusterGuides = (cluster: GuideCluster) => procurementGuides.filter((g) => g.cluster === cluster);

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-4 md:px-6 pt-12 md:pt-16 pb-10 mx-auto max-w-6xl">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
        Knowledge Center
      </p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Procurement & Technical Guides
      </h1>
      <p class="mt-4 text-xl text-gray-500 dark:text-slate-400 font-medium">
        Straight answers for drop stitch pool buyers — sourcing, quality engineering, pricing and logistics, written by
        the team that manufactures the pools.
      </p>
    </header>
  </section>

  <div class="px-4 md:px-6 pb-16 mx-auto max-w-6xl space-y-14">
    {
      clusterOrder.map((cluster) => (
        <section>
          <div class="flex items-center gap-3 mb-5">
            <span class="flex w-10 h-10 items-center justify-center rounded-xl bg-sky-100 dark:bg-sky-900/50 text-primary dark:text-sky-300">
              <Icon name={clusterIcons[cluster]} class="w-5 h-5" />
            </span>
            <div>
              <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100">
                {GUIDE_CLUSTER_LABELS[cluster]}
              </h2>
              <p class="text-sm text-gray-500 dark:text-slate-400">{clusterDescriptions[cluster]}</p>
            </div>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {clusterGuides(cluster).map((g) => (
              <a
                href={`/guides/${g.slug}`}
                class="group p-6 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700 hover:border-primary dark:hover:border-sky-500 hover:shadow-lg transition-all flex flex-col"
              >
                <h3 class="text-base font-bold text-gray-900 dark:text-slate-100 mb-2 group-hover:text-primary dark:group-hover:text-sky-400 transition-colors">
                  {g.title}
                </h3>
                <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed mb-4 flex-1">{g.description}</p>
                <div class="flex items-center justify-between text-xs text-gray-400 dark:text-slate-500">
                  <span>{formatDate(g.updateDate)}</span>
                  <span class="inline-flex items-center gap-1">
                    <Icon name="tabler:clock" class="w-3.5 h-3.5" /> {g.readMinutes} min
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <section>
      <div class="flex items-center gap-3 mb-5">
        <span
          class="flex w-10 h-10 items-center justify-center rounded-xl bg-sky-100 dark:bg-sky-900/50 text-primary dark:text-sky-300"
        >
          <Icon name="tabler:pool" class="w-5 h-5" />
        </span>
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100">Pool Owner Guides</h2>
          <p class="text-sm text-gray-500 dark:text-slate-400">
            Setup, care and choosing the right pool — for you and your customers.
          </p>
        </div>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {
          guides.map((g) => (
            <a
              href={`/guides/${g.slug}`}
              class="group p-6 rounded-2xl bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700 hover:border-primary dark:hover:border-sky-500 hover:shadow-lg transition-all flex flex-col"
            >
              <h3 class="text-base font-bold text-gray-900 dark:text-slate-100 mb-2 group-hover:text-primary dark:group-hover:text-sky-400 transition-colors">
                {g.title}
              </h3>
              <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed mb-4 flex-1">{g.description}</p>
              <span class="text-xs font-medium text-primary dark:text-sky-400 inline-flex items-center gap-1">
                Read guide <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" />
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="p-8 rounded-2xl bg-gray-900 dark:bg-slate-800 text-center">
      <h2 class="text-2xl font-bold text-white mb-2">Need answers specific to your order?</h2>
      <p class="text-gray-300 dark:text-slate-300 mb-6 max-w-xl mx-auto">
        Every quotation includes itemized FOB pricing, packed weights, carton dimensions and a container loading plan —
        prepared by our Qingdao factory team.
      </p>
      <a
        href="/request-quotation"
        class="inline-flex items-center gap-2 px-6 py-3 bg-white text-gray-900 font-semibold rounded-full hover:bg-gray-100 transition-all text-sm"
      >
        <Icon name="tabler:file-invoice" class="w-4 h-4" /> Request a Bulk Quote
      </a>
    </div>
  </div>

  <section class="sr-only" data-ai-block="guides-index" aria-hidden="true">
    <p>
      Inflatable Pool Factory publishes procurement and technical guides for drop stitch inflatable pool buyers: how to
      choose a drop stitch pool manufacturer (7 evaluation criteria: factory ownership, drop-stitch engineering,
      pressure-test QC, MOQ and sampling, material compliance, export experience, design confidentiality); OEM vs ODM
      manufacturing models; a private label buyer's guide (logo printing, custom colors, retail packaging, quantity
      terms and sample process); inflatable pool pressure testing explained (model-specific operating pressure,
      relief-valve setting confirmed in the specification, and pressure/leak testing to the approved production
      specification); wholesale drop stitch pool costs (FOB Qingdao prices from $137.96 to $1,753.74 across round,
      rectangular and SPA tub series); and container loading planning (packed weights 18.4-250 kg per pool, 20GP vs
      40HQ, 5-10% of rigid pool shipping volume). Plus consumer guides on choosing, setting up and maintaining
      inflatable pools.
    </p>
  </section>
</Layout>
