---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import type { MetaData } from '~/types';

interface BusinessTrack {
  icon: string;
  title: string;
  description: string;
  points: string[];
  href: string;
  quoteHref: string;
  cta: string;
}

const tracks: BusinessTrack[] = [
  {
    icon: 'tabler:building-cottage',
    title: 'Vacation Rentals & Glamping',
    description:
      'Equip cabins, glamping sites, and short-term rentals with pools and SPA tubs that install in under an hour and store in the off-season.',
    points: [
      'Seasonal setups with no construction',
      'Commercial configurations available',
      'Volume pricing for multi-unit sites',
    ],
    href: '/pool-ideas/pools-for-vacation-rentals',
    quoteHref:
      '/request-quotation?buyer=Hotel%20%2F%20Resort%20%2F%20Hospitality&product=Commercial%20pool%20for%20a%20vacation%20rental',
    cta: 'See rental setups',
  },
  {
    icon: 'tabler:building-store',
    title: 'Retail & Brand Partners',
    description:
      'Stock the retail Inflatable Pool Factory range or become a distribution partner for drop-stitch pools and SPA tubs in your market.',
    points: [
      'Wholesale program with project-specific MOQ',
      'Full size and FOB price matrix published',
      'Qingdao-based production and order coordination',
    ],
    href: '/wholesale',
    quoteHref: '/request-quotation?buyer=Importer%20%2F%20Distributor&product=Wholesale%20drop-stitch%20pool%20range',
    cta: 'Wholesale program',
  },
  {
    icon: 'tabler:tools',
    title: 'Custom OEM / ODM',
    description:
      'Your specification, our factory: custom sizes, colors, logo printing, covers, and retail packaging produced at our Qingdao manufacturing base.',
    points: [
      'Five-step documented production process',
      'Pressure and leak-test requirements agreed per project',
      'Custom packaging and accessories',
    ],
    href: '/oem-odm',
    quoteHref: '/request-quotation?buyer=Brand%20Owner%20%2F%20Private%20Label&product=Custom%20OEM%20%2F%20ODM%20pool',
    cta: 'OEM / ODM details',
  },
  {
    icon: 'tabler:tag',
    title: 'Private Label Pools',
    description:
      'Launch your own pool brand on proven drop-stitch platforms — from product adaptation to branded packaging and documentation.',
    points: [
      'Your brand on standard drop-stitch platforms',
      'Branded manuals, packaging, and warranty docs',
      'QC checkpoints agreed with your team',
    ],
    href: '/private-label',
    quoteHref: '/request-quotation?buyer=Brand%20Owner%20%2F%20Private%20Label&product=Private-label%20pool%20program',
    cta: 'Private label program',
  },
];

const valueMatrix: Array<{ challenge: string; solution: string; reality: string }> = [
  {
    challenge: 'Limited permitting & construction time',
    solution: 'Portable, above-ground drop-stitch structures deploy in under 30 minutes without excavation.',
    reality: 'Requires flat, level ground and compliant access to water fill/drain points.',
  },
  {
    challenge: 'Commercial guest wear & tear',
    solution:
      'Dual-layer reinforced PVC skin and thousands of vertical drop-stitch polyester threads create rigid wall stability.',
    reality: 'Designed for heavy recreational use; daily bather limits and water sanitation still apply.',
  },
  {
    challenge: 'Turnaround sanitation & efficiency',
    solution: 'Dual high-flow valves and standard filter pump quick-connect fittings allow efficient water treatment.',
    reality: 'Guests must be briefed on pool rules; routine chemical balancing remains required.',
  },
  {
    challenge: 'Custom branding & fit',
    solution: 'Custom dimensions, co-branded logo placement, custom colors, and retail-ready packaging.',
    reality: 'MOQ and sample requirements are confirmed per project scope and order volume.',
  },
];

const resources: Array<{ title: string; description: string; href: string }> = [
  {
    title: 'Commercial Pools',
    description: 'Larger-format pools for commercial and event applications.',
    href: '/commercial-pools',
  },
  {
    title: 'Manufacturing Process',
    description: 'Inside the five-step Qingdao production line, from CNC cutting to pressure testing.',
    href: '/manufacturing',
  },
  {
    title: 'Quality Control',
    description:
      'Pressure-test method, seam inspection and material documentation matched to the approved specification.',
    href: '/quality-control',
  },
  {
    title: 'Specs & FOB Price List',
    description: 'The complete size ladder and FOB Qingdao price matrix, updated October 2026.',
    href: '/products/specs',
  },
];

const procurementFaqs = [
  {
    q: 'Which types of buyers do you work with?',
    a: 'Brand owners, private-label companies, importers, distributors, retailers, e-commerce sellers, hotels, resorts, rental operators and commercial project teams.',
  },
  {
    q: 'Can you support both standard products and custom projects?',
    a: 'Yes. You can start from our standard drop-stitch collections or discuss custom sizes, colors, branding and packaging. The applicable OEM or ODM scope is confirmed after we review your requirements.',
  },
  {
    q: 'What should we include in an initial inquiry?',
    a: 'Your buyer type, product type or reference product, target dimensions, estimated quantity, target market and any branding or packaging requirements. Drawings and reference images are welcome.',
  },
  {
    q: 'How do we start a project?',
    a: 'Submit the RFQ form or email our team. We will review the brief, confirm the next steps and identify any technical details needed before quotation.',
  },
  {
    q: 'Can we evaluate a sample before a bulk order?',
    a: 'Sample requirements and approval criteria are reviewed per project. Where a sample stage applies, the sample specification, cost and timing are confirmed in the quotation.',
  },
  {
    q: 'How are finished pools tested for leaks?',
    a: 'Production units are pressure and leak tested to the method, hold time and acceptance criteria agreed in the approved production specification. The applicable records are confirmed per project.',
  },
  {
    q: 'Which compliance documents are available for our market?',
    a: 'Material and compliance documentation is reviewed against your target market and confirmed per project. Ask for the applicable documents in your RFQ.',
  },
  {
    q: 'Can you support third-party inspection?',
    a: 'Third-party inspection can be arranged. The inspection scope, timing and cost are confirmed per project.',
  },
  {
    q: 'Who is the contracting entity and where is production carried out?',
    a: 'Inflatable Pool Factory is the pool brand of the Inflatable Pool Team at Qingdao Vatrad Group, based in Qingdao, China. Production takes place at our Qingdao manufacturing base; the contracting entity, production location and shipping terms are stated in your quotation and order documents.',
  },
];

const metadata = merge(
  {
    title: `B2B Inflatable Pool Solutions | ${SITE.name}`,
    description: `Inflatable pool manufacturing, custom product development and private-label solutions for brands, importers, retailers and commercial buyers.`,
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata} breadcrumbs={[{ name: 'For Businesses' }]}>
  <section class="px-4 md:px-6 pt-12 md:pt-16 pb-10 mx-auto max-w-6xl">
    <header class="mb-10 md:mb-14 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">For Businesses</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        B2B Inflatable Pool Solutions for Brands and Commercial Buyers
      </h1>
      <p class="mt-4 text-xl text-gray-500 dark:text-slate-400 font-medium leading-relaxed">
        We support B2B buyers seeking inflatable swimming pool manufacturing, custom product development and
        private-label solutions. Whether you are developing a new product, expanding an existing range or sourcing for a
        commercial project, our team can review your requirements and discuss the appropriate manufacturing approach.
      </p>
      <div class="mt-6 flex flex-wrap gap-2 text-sm">
        {
          [
            'OEM and ODM manufacturing',
            'Custom product development',
            'Private-label and packaging options',
            'Product sourcing for commercial applications',
          ].map((item) => (
            <span class="inline-flex items-center rounded-full bg-sky-50 dark:bg-sky-900/40 px-3 py-1.5 font-medium text-sky-700 dark:text-sky-300">
              {item}
            </span>
          ))
        }
      </div>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {
        tracks.map((track) => (
          <div class="flex flex-col bg-white dark:bg-slate-900 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm hover:shadow-xl transition-shadow p-7">
            <Icon name={track.icon} class="w-9 h-9 text-primary dark:text-blue-400 mb-4" />
            <h2 class="text-xl font-semibold font-heading dark:text-slate-100 mb-2">{track.title}</h2>
            <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed mb-4">{track.description}</p>
            <ul class="space-y-2 mb-6 flex-1">
              {track.points.map((p) => (
                <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-slate-300">
                  <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-green-500 shrink-0" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
            <a
              href={track.href}
              class="inline-flex items-center justify-center gap-2 w-full px-4 py-3 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
            >
              {track.cta}
              <Icon name="tabler:arrow-right" class="w-4 h-4" />
            </a>
            <a
              href={track.quoteHref}
              class="mt-2 inline-flex items-center justify-center gap-1.5 w-full px-4 py-2.5 text-sm font-semibold text-primary dark:text-sky-400 hover:underline"
            >
              Request a quote for this buyer type
              <Icon name="tabler:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        ))
      }
    </div>

    <!-- Why partner -->
    <div class="mt-14">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-2">
        Why partner with Inflatable Pool Factory?
      </h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-6 max-w-2xl">
        Every row pairs an operational challenge with how our drop-stitch platform answers it — and the practical
        realities your team should plan for.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-slate-800/70 text-left">
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                Operational challenge
              </th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                How Inflatable Pool Factory solves it
              </th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                Technical &amp; practical reality
              </th>
            </tr>
          </thead>
          <tbody>
            {
              valueMatrix.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-800/40'}>
                  <td class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-200 align-top">{row.challenge}</td>
                  <td class="px-4 py-3 text-gray-600 dark:text-slate-300 align-top leading-relaxed">{row.solution}</td>
                  <td class="px-4 py-3 text-gray-500 dark:text-slate-400 align-top leading-relaxed">{row.reality}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Resources -->
    <div class="mt-14">
      <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
        Factory &amp; program resources
      </h2>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {
          resources.map((r) => (
            <a
              href={r.href}
              class="block p-5 bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-700 hover:shadow-md transition-shadow"
            >
              <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-200 mb-1">{r.title}</h3>
              <p class="text-xs text-gray-500 dark:text-slate-400 leading-relaxed">{r.description}</p>
              <span class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-sky-600 dark:text-sky-400">
                Open
                <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" />
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Procurement FAQ -->
    <div class="mt-14">
      <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
        Common procurement questions
      </h2>
      <div class="space-y-3">
        {
          procurementFaqs.map((faq) => (
            <details class="group rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 open:shadow-sm transition-shadow">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer text-sm font-semibold text-gray-900 dark:text-slate-200 list-none">
                {faq.q}
                <span class="shrink-0 ml-2 text-gray-300 dark:text-slate-600 group-open:rotate-180 transition-transform text-xs">
                  &#9660;
                </span>
              </summary>
              <div class="px-5 pb-4 text-sm text-gray-600 dark:text-slate-400 leading-relaxed border-t border-gray-100 dark:border-slate-700 pt-3 mt-0">
                {faq.a}
              </div>
            </details>
          ))
        }
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-14 bg-gray-900 dark:bg-slate-800 rounded-2xl px-6 sm:px-10 py-10 text-center">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-3">Have a project in mind?</h2>
      <p class="text-gray-300 dark:text-slate-300 max-w-xl mx-auto mb-6">
        Tell us your buyer type, sizes, quantities and target market — our team will review the brief and confirm the
        next steps.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/request-quotation"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-white text-gray-900 font-semibold rounded-full hover:bg-gray-100 transition-all"
        >
          Request a Quotation
          <Icon name="tabler:arrow-right" class="w-5 h-5" />
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-8 py-3.5 border-2 border-white/30 text-white font-medium rounded-full hover:bg-white/10 transition-all"
        >
          Contact the Team
        </a>
      </div>
    </div>
  </section>
  <JsonLd type="FAQPage" faqs={procurementFaqs.map((faq) => ({ q: faq.q, a: faq.a }))} />
</Layout>
