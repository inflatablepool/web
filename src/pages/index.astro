---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ProductCard from '~/components/widgets/ProductCard.astro';
import Icon from '~/components/ui/Icon.astro';
import { getProducts } from '~/utils/products';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/home.ts';
import { getUiForLang } from '~/i18n/generated/ui-all';

const lang = 'en';
const t = (key: string) => getUiForLang(lang)?.[key] || '';

setPageContentData(__pageData);
const page = getPageContent(lang, 'home');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const categories = page.content_categories ?? {};
const capabilities = page.oem_capabilities ?? {};
const manufacturing = page.manufacturing_process ?? {};
const quality = page.quality_control ?? {};
const industries = page.industries ?? {};
const project = page.project_development ?? {};
const b2bFaqs = page.b2b_faqs ?? {};
const consumerIntro = page.consumer_intro ?? {};
const compareCollections = page.compare_collections ?? {};
const customerTypes = page.content_customer_types ?? {};
const features = page.features ?? {};
const compliance = page.content_compliance ?? {};
const steps = page.steps ?? {};
const faqs = page.faqs ?? {};
const cta = page.cta ?? {};

const poolProducts = await getProducts({ limit: 3 });

const customerItems = (customerTypes.items ?? []).map(
  (item: { title: string; description: string; icon?: string; cta?: string; cta_href?: string }) => ({
    title: item.title,
    description: item.description,
    icon: item.icon,
    callToAction: item.cta ? { text: item.cta, href: item.cta_href, icon: 'tabler:arrow-right' } : undefined,
  })
);

const industryItems = (industries.items ?? []).map(
  (item: { title: string; description: string; icon?: string; cta?: string; cta_href?: string }) => ({
    title: item.title,
    description: item.description,
    icon: item.icon,
    callToAction: item.cta ? { text: item.cta, href: item.cta_href, icon: 'tabler:arrow-right' } : undefined,
  })
);

const metadata = {
  title: `Custom Drop Stitch Inflatable Pool Manufacturer | Inflatable Pool Factory`,
  description:
    'Drop-stitch inflatable pools for wholesale, OEM/ODM and private-label projects. Compare specifications and customization, then request a quote.',
};
---

<Layout metadata={metadata}>
  {
    hero.image || hero.title ? (
      <Hero
        tagline={hero.tagline}
        title={hero.title}
        subtitle={hero.subtitle}
        actions={hero.actions}
        image={hero.image}
      />
    ) : null
  }

  <Stats title={stats.title} stats={stats.stats} />

  <!-- Product categories: the fastest route from manufacturer positioning to real products. -->
  {
    poolProducts.length > 0 && (
      <section class="px-4 py-12 sm:px-6 mx-auto max-w-6xl">
        <div class="text-center mb-8">
          <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
            {categories.tagline || t('product.catalog') || 'Product Categories'}
          </p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">
            {categories.title || 'Inflatable Pools We Manufacture'}
          </h2>
          <p class="mt-3 text-xl text-muted dark:text-slate-400 font-medium max-w-2xl mx-auto">
            {categories.subtitle || ''}
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {poolProducts.map((p) => (
            <ProductCard product={p} lang={lang} />
          ))}
        </div>
        <div class="mt-8 text-center">
          <a
            href="/products"
            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-200 dark:border-slate-600 text-gray-700 dark:text-slate-300 font-medium rounded-full hover:border-gray-300 dark:hover:border-slate-500 hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm"
          >
            <Icon name="tabler:pool" class="w-4 h-4" />
            View All Pools
          </a>
        </div>
      </section>
    )
  }

  <Features2
    tagline={capabilities.tagline}
    title={capabilities.title}
    subtitle={capabilities.subtitle}
    columns={2}
    items={capabilities.items}
  />
  {
    capabilities.cta?.href && (
      <div class="max-w-7xl mx-auto px-4 md:px-6 -mt-8 pb-10 text-center">
        <a
          href={capabilities.cta.href}
          class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-slate-600 font-semibold rounded-full hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm"
        >
          {capabilities.cta.text}
          <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
      </div>
    )
  }

  <Steps2
    tagline={manufacturing.tagline}
    title={manufacturing.title}
    subtitle={manufacturing.subtitle}
    items={manufacturing.items}
    callToAction={manufacturing.cta}
  />

  <Features2
    tagline={quality.tagline}
    title={quality.title}
    subtitle={quality.subtitle}
    columns={4}
    items={quality.items}
  />
  {
    quality.cta?.href && (
      <div class="max-w-7xl mx-auto px-4 md:px-6 -mt-8 pb-10 flex flex-wrap justify-center gap-3">
        <a
          href={quality.cta.href}
          class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-slate-600 font-semibold rounded-full hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm"
        >
          {quality.cta.text}
          <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
        <a
          href="/quality-control/destructive-testing/results"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-slate-700 text-white font-semibold rounded-full hover:bg-gray-800 dark:hover:bg-slate-600 transition-all text-sm"
        >
          <Icon name="tabler:file-download" class="w-4 h-4" />
          Destructive test results — 8/8 PASS
        </a>
      </div>
    )
  }

  <Features2
    tagline={industries.tagline}
    title={industries.title}
    subtitle={industries.subtitle}
    columns={4}
    items={industryItems}
  />

  <Steps2
    tagline={project.tagline}
    title={project.title}
    subtitle={project.subtitle}
    items={project.items}
    callToAction={project.cta}
  />

  <FAQs title={b2bFaqs.title} subtitle={b2bFaqs.subtitle} columns={b2bFaqs.columns} items={b2bFaqs.items} />

  <!-- Consumer content remains available below the B2B decision path. -->
  <section class="px-4 sm:px-6 mx-auto max-w-6xl">
    <div
      class="rounded-3xl border border-gray-200 dark:border-slate-700 bg-gray-50/60 dark:bg-slate-900/40 px-6 py-8 text-center"
    >
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
        {consumerIntro.tagline}
      </p>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight font-heading">{consumerIntro.title}</h2>
      <p class="mt-3 text-muted dark:text-slate-400 max-w-3xl mx-auto">{consumerIntro.subtitle}</p>
    </div>
  </section>

  {
    compareCollections.rows ? (
      <section class="px-4 py-12 sm:px-6 mx-auto max-w-6xl">
        <div class="text-center mb-8">
          {compareCollections.tagline && (
            <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
              {compareCollections.tagline}
            </p>
          )}
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading" set:html={compareCollections.title} />
          <p class="mt-3 text-xl text-muted dark:text-slate-400 font-medium max-w-2xl mx-auto">
            {compareCollections.subtitle}
          </p>
        </div>
        <div class="overflow-x-auto rounded-2xl border border-gray-100 dark:border-slate-700">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 dark:bg-slate-800/60 text-left">
                <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">
                  {compareCollections.headers?.collection}
                </th>
                <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">
                  {compareCollections.headers?.sizes}
                </th>
                <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">
                  {compareCollections.headers?.best_for}
                </th>
              </tr>
            </thead>
            <tbody>
              {compareCollections.rows.map(
                (row: { collection: string; sizes: string; best_for: string; href: string }) => (
                  <tr class="border-t border-gray-100 dark:border-slate-700">
                    <td class="px-4 py-3">
                      <a class="font-medium text-primary hover:underline" href={row.href}>
                        {row.collection}
                      </a>
                    </td>
                    <td class="px-4 py-3 text-gray-600 dark:text-slate-300 whitespace-nowrap">{row.sizes}</td>
                    <td class="px-4 py-3 text-gray-600 dark:text-slate-300">{row.best_for}</td>
                  </tr>
                )
              )}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-center text-sm text-muted dark:text-slate-400">{compareCollections.note}</p>
      </section>
    ) : null
  }

  <section class="px-4 pb-12 sm:px-6 mx-auto max-w-6xl">
    <div class="text-center mb-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
        Technical Resources
      </p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">
        Understand the construction before you specify
      </h2>
      <p class="mt-3 text-xl text-muted dark:text-slate-400 font-medium max-w-2xl mx-auto">
        Published explanations, material guidance and calculators for buyers, engineers and product teams.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      {
        [
          {
            title: 'Drop Stitch Technology Center',
            href: '/drop-stitch-pool-technology',
            body: 'How internal threads, PVC laminates, wall geometry, pressure and testing work together.',
            icon: 'tabler:stack-2',
          },
          {
            title: '1000D vs 1500D PVC Guide',
            href: '/drop-stitch-pool-materials',
            body: 'What denier does and does not tell you, plus the material data to request.',
            icon: 'tabler:layers-intersect',
          },
          {
            title: 'Water Capacity Calculator',
            href: '/inflatable-pool-water-capacity',
            body: 'Estimate cubic metres, litres, gallons and water weight from internal dimensions.',
            icon: 'tabler:calculator',
          },
        ].map((item) => (
          <a
            href={item.href}
            class="rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 hover:border-sky-300 dark:hover:border-sky-700 transition-colors"
          >
            <span class="mb-3 flex w-10 h-10 items-center justify-center rounded-xl bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300">
              <Icon name={item.icon} class="w-5 h-5" />
            </span>
            <span class="block font-bold text-gray-900 dark:text-slate-100">{item.title}</span>
            <span class="mt-1.5 block text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{item.body}</span>
          </a>
        ))
      }
    </div>
  </section>

  <Features2
    id={features.id}
    tagline={features.tagline}
    title={features.title}
    subtitle={features.subtitle}
    columns={3}
    items={features.items}
  />

  <Features2
    tagline={customerTypes.tagline}
    title={customerTypes.title}
    subtitle={customerTypes.subtitle}
    columns={3}
    items={customerItems}
  />

  <Steps2 title={steps.title} items={steps.items} image={steps.image} />

  <Features2
    tagline={compliance.tagline}
    title={compliance.title}
    subtitle={compliance.subtitle}
    columns={4}
    items={compliance.items}
  />

  <FAQs title={faqs.title} subtitle={faqs.subtitle} columns={faqs.columns} items={faqs.items} />

  {cta.title ? <CallToAction title={cta.title} subtitle={cta.subtitle} actions={cta.actions ?? []} /> : null}
</Layout>
