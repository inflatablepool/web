---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { POOL_IDEAS } from '~/data/pool-ideas';
import { SITE } from 'astrowind:config';
import type { MetaData } from '~/types';

const metadata = merge(
  {
    title: `Pool Ideas & Inspiration | ${SITE.name}`,
    description: `Backyard pool ideas for Inflatable Pool Factory drop-stitch pools — families, small spaces, gatherings, cold plunge, pets and rentals.`,
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata} breadcrumbs={[{ name: 'Pool Ideas' }]}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-10 md:mb-14 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Pool Ideas</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Find the Right Pool for Your Life
      </h1>
      <p class="mt-4 text-xl text-gray-500 dark:text-slate-400 font-medium leading-relaxed">
        Every backyard is different. Start from your situation — family, space, or project — and we&#39;ll show you the
        products, sizes, and safety basics that fit.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        POOL_IDEAS.map((idea) => (
          <a
            href={`/pool-ideas/${idea.slug}`}
            class="group flex flex-col bg-white dark:bg-slate-900 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm hover:shadow-xl transition-shadow overflow-hidden"
          >
            {idea.image && (
              <img
                src={idea.image}
                srcset={`${idea.image.replace(/\.webp$/, '-640.webp')} 640w, ${idea.image} 1200w`}
                sizes="(min-width: 1024px) 384px, (min-width: 768px) 50vw, 100vw"
                alt={idea.imageAlt ?? idea.title}
                class="aspect-[4/3] w-full object-cover"
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center justify-between mb-3">
                <h2 class="text-lg font-semibold font-heading dark:text-slate-100 group-hover:text-primary transition-colors">
                  {idea.navTitle}
                </h2>
              </div>
              <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed flex-1">{idea.intro[0]}</p>
              <div class="mt-4 pt-4 border-t border-gray-100 dark:border-slate-800">
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {idea.matches.map((m) => (
                    <span class="px-2.5 py-1 bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 text-xs font-medium rounded-full">
                      {m.series === 'round' || m.series === 'hot-tub-round'
                        ? 'Round'
                        : m.series === 'rect-square'
                          ? 'Rectangular'
                          : m.series === 'hot-tub-square-rect'
                            ? 'Square SPA'
                            : 'SPA Tub'}
                    </span>
                  ))}
                </div>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-blue-400">
                  Explore this idea
                  <Icon name="tabler:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-14 bg-gray-900 dark:bg-slate-800 rounded-2xl px-6 sm:px-10 py-10 text-center">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-3">Not sure where to start?</h2>
      <p class="text-gray-300 dark:text-slate-300 max-w-xl mx-auto mb-6">
        Answer three simple questions about your space and plans, and narrow the range down to the right model.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/find-your-pool"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-white text-gray-900 font-semibold rounded-full hover:bg-gray-100 transition-all"
        >
          Find Your Pool
          <Icon name="tabler:arrow-right" class="w-5 h-5" />
        </a>
        <a
          href="/products"
          class="inline-flex items-center gap-2 px-8 py-3.5 border-2 border-white/30 text-white font-medium rounded-full hover:bg-white/10 transition-all"
        >
          Shop All Pools
        </a>
      </div>
    </div>
  </section>
</Layout>
