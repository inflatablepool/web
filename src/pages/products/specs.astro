---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import type { MetaData } from '~/types';
import {
  poolSeries,
  poolAccessories,
  POOL_PRESSURE_SPECS,
  POOL_PRODUCTION_STEPS,
  POOL_KEY_FEATURES,
  POOL_BUSINESS_ADVANTAGES,
  PRICE_BASIS_NOTE,
} from '~/data/pool-catalog';

export const prerender = true;

/** Month the factory price list was last confirmed with the sales team */
const PRICE_LIST_UPDATED = 'October 2026';

const tocLinks = [
  { href: '#round', label: 'Round Pools' },
  { href: '#rect-square', label: 'Rectangular / Square' },
  { href: '#hot-tub-square-rect', label: 'Square / Rect SPA' },
  { href: '#hot-tub-round', label: 'Round SPA' },
  { href: '#accessories', label: 'Accessories' },
  { href: '#pricing-rules', label: 'Pricing Rules' },
  { href: '#pressure', label: 'Pressure & Safety' },
  { href: '#production', label: 'Production' },
  { href: '#videos', label: 'Videos' },
  { href: '#advantages', label: 'Why Import' },
];

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: [
    {
      '@type': 'VideoObject',
      name: 'Inflatable Pool Factory Drop-Stitch Pool Demo — Inflation & Rigidity',
      description:
        'Inflatable Pool Factory drop-stitch inflatable pool inflating to full 4–5 PSI rigidity and holding its shape under load.',
      thumbnailUrl: `${SITE.site}/images/pools/rectangular-pool-2.webp`,
      uploadDate: '2026-10-01',
      contentUrl: `${SITE.site}/videos/pools/inflatablepoolfactory-pool-demo-1.mp4`,
      embedUrl: `${SITE.site}/products/specs#videos`,
    },
    {
      '@type': 'VideoObject',
      name: 'Inflatable Pool Factory Drop-Stitch Pool Demo — Wall Strength & Setup',
      description:
        'An Inflatable Pool Factory drop-stitch pool being set up with the included 1000W electric pump, showing rigid drop-stitch walls.',
      thumbnailUrl: `${SITE.site}/images/pools/round-grey-pool-1.webp`,
      uploadDate: '2026-10-01',
      contentUrl: `${SITE.site}/videos/pools/inflatablepoolfactory-pool-demo-2.mp4`,
      embedUrl: `${SITE.site}/products/specs#videos`,
    },
  ],
};

const metadata = merge(
  {
    title: `Pool Specifications & FOB Price List | ${SITE.name}`,
    description: `Complete Inflatable Pool Factory drop-stitch pool specification and FOB Qingdao price list — round pools, rectangular/square pools, and hot tub SPA models with sizes, wall thicknesses, weights, and wholesale prices.`,
    canonical: getCanonical('/products/specs'),
    robots: { index: true, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;

const formatUsd = (n: number) =>
  `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 mx-auto max-w-6xl">
    <header class="mb-10 md:mb-12 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
        Factory Price List
      </p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Pool Specifications & FOB Price List
      </h1>
      <p class="mt-3 md:mt-4 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium">
        Complete drop-stitch pool catalog — sizes, wall thicknesses, weights, and FOB Qingdao wholesale prices.
      </p>
      <p class="mt-4 mx-auto max-w-2xl text-sm text-gray-400 dark:text-slate-500">
        {PRICE_BASIS_NOTE}
      </p>
      <p class="mt-2 mx-auto max-w-2xl text-sm font-medium text-gray-500 dark:text-slate-400">
        Price list last updated: <time datetime="2026-10">{PRICE_LIST_UPDATED}</time>
      </p>
    </header>

    <!-- Anchor navigation -->
    <nav
      aria-label="Price list sections"
      class="mb-12 sticky top-16 z-10 -mx-4 px-4 py-2.5 bg-white/90 dark:bg-slate-900/90 backdrop-blur border-b border-gray-100 dark:border-slate-800"
    >
      <ul class="flex flex-wrap gap-1.5 max-w-6xl mx-auto">
        {
          tocLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class="inline-block px-3 py-1.5 text-xs font-medium rounded-full text-gray-600 dark:text-slate-300 bg-gray-100 dark:bg-slate-800 hover:bg-sky-100 hover:text-primary dark:hover:bg-sky-900/50 dark:hover:text-sky-300 transition-colors"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Key Features -->
    <div class="mb-14 grid sm:grid-cols-2 gap-4">
      {
        POOL_KEY_FEATURES.map((f) => (
          <div class="flex gap-4 p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
            <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-xl bg-sky-100 dark:bg-sky-900/50 text-primary dark:text-sky-300">
              <Icon name={f.icon} class="w-5 h-5" />
            </span>
            <div>
              <h2 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1">{f.title}</h2>
              <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{f.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="space-y-14">
      {
        poolSeries.map((series) => (
          <section id={series.id} class="scroll-mt-24">
            <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
              <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100">{series.name}</h2>
              <span class="text-sm font-medium text-gray-400 dark:text-slate-500">{series.heading}</span>
            </div>
            <p class="text-sm text-gray-500 dark:text-slate-400 mb-4 max-w-3xl">{series.highlights}</p>

            <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-slate-700 mb-4">
              <table class="w-full text-sm">
                <thead>
                  <tr class="bg-gray-50 dark:bg-slate-800/70 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400">
                    <th class="px-4 py-3">Item No.</th>
                    <th class="px-4 py-3">Size (m)</th>
                    <th class="px-4 py-3">Wall</th>
                    <th class="px-4 py-3">Packed weight</th>
                    <th class="px-4 py-3 text-right">FOB Qingdao</th>
                    <th class="px-4 py-3 text-right">
                      <span class="sr-only">Quote</span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {series.items.map((item, i) => (
                    <tr class={i % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-800/40'}>
                      <td class="px-4 py-2.5 font-mono text-xs text-gray-500 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800">
                        {item.item}
                      </td>
                      <td class="px-4 py-2.5 font-medium text-gray-800 dark:text-slate-200 border-b border-gray-100 dark:border-slate-800">
                        {item.size}
                      </td>
                      <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800">
                        {item.wall}
                      </td>
                      <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800">
                        {item.weightKg ? `${item.weightKg} kg` : 'On request'}
                      </td>
                      <td class="px-4 py-2.5 text-right font-semibold text-gray-900 dark:text-slate-100 border-b border-gray-100 dark:border-slate-800">
                        {formatUsd(item.fobUsd)}
                      </td>
                      <td class="px-4 py-2.5 text-right border-b border-gray-100 dark:border-slate-800">
                        <a
                          href={`/request-quotation?product=${encodeURIComponent(`${item.item} — ${item.size}`)}`}
                          class="inline-flex items-center gap-1 whitespace-nowrap text-xs font-semibold text-primary dark:text-sky-400 hover:underline"
                          aria-label={`Request a quote for item ${item.item}, size ${item.size}`}
                        >
                          Quote
                          <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" />
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                Standard inclusions:
              </span>
              {series.included.map((inc) => (
                <span class="px-2.5 py-1 bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 text-xs font-medium rounded-full">
                  {inc}
                </span>
              ))}
              {series.includedImage && (
                <span class="ml-1 inline-flex items-center gap-2 px-2 py-1 rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900">
                  <img
                    src={series.includedImage}
                    alt={`${series.name} standard factory inclusions`}
                    class="h-10 w-auto rounded"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="text-[10px] font-medium uppercase tracking-wider text-gray-400 dark:text-slate-500">
                    Factory photo
                  </span>
                </span>
              )}
            </div>

            <div class="mt-4">
              <a
                href={`/request-quotation?product=${encodeURIComponent(series.name)}`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-sky-400 hover:underline"
              >
                Request a bulk quote for {series.name}
                <Icon name="tabler:arrow-right" class="w-4 h-4" />
              </a>
            </div>
          </section>
        ))
      }

      <!-- Optional Accessories -->
      <section id="accessories" class="scroll-mt-24">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
          <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100">Optional Accessories</h2>
          <span class="text-sm font-medium text-gray-400 dark:text-slate-500">Extra charge</span>
        </div>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">
          Add-ons that complete turnkey pool packages — entry/exit assistance, pumping, and water circulation.
        </p>
        <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-slate-700">
          <table class="w-full text-sm">
            <thead>
              <tr
                class="bg-gray-50 dark:bg-slate-800/70 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400"
              >
                <th class="px-4 py-3">Photo</th>
                <th class="px-4 py-3">Accessory</th>
                <th class="px-4 py-3">Specification</th>
                <th class="px-4 py-3 text-right">FOB Qingdao</th>
              </tr>
            </thead>
            <tbody>
              {
                poolAccessories.map((acc, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-800/40'}>
                    <td class="px-4 py-2.5 border-b border-gray-100 dark:border-slate-800">
                      {acc.image ? (
                        <img
                          src={acc.image}
                          alt={acc.name}
                          class="h-14 w-auto rounded-md border border-gray-100 dark:border-slate-700"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="text-gray-300 dark:text-slate-600">—</span>
                      )}
                    </td>
                    <td class="px-4 py-2.5 font-medium text-gray-800 dark:text-slate-200 border-b border-gray-100 dark:border-slate-800">
                      {acc.name}
                    </td>
                    <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800">
                      {acc.spec}
                    </td>
                    <td class="px-4 py-2.5 text-right font-semibold text-gray-900 dark:text-slate-100 border-b border-gray-100 dark:border-slate-800">
                      {formatUsd(acc.fobUsd)}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- Pricing Rules -->
      <section id="pricing-rules" class="scroll-mt-24">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">
          Pricing & Ordering Rules
        </h2>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">
          How FOB pricing works for wholesale orders, samples and custom quotes.
        </p>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
            <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-2">Standard FOB Pricing</h3>
            <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">
              The prices on this page are indicative FOB Qingdao reference prices in USD. Quantity basis and final price
              are confirmed in your quotation. Mixed containers combining several SKUs and accessories are welcome and
              are quoted itemized.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
            <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-2">Sample Orders</h3>
            <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">
              Sample requirements, sample charges and approval steps are confirmed per project before a volume order is
              released. This lets you verify quality in your market before committing to production.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
            <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-2">Custom & OEM/ODM Quotes</h3>
            <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">
              Custom sizes, colors, logo printing, covers and retail packaging are quoted individually after engineering
              review. See our <a href="/oem-odm" class="text-primary dark:text-sky-400 hover:underline">OEM/ODM page</a> for
              the project flow.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
            <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-2">Validity & Incoterms</h3>
            <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">
              Prices are valid for the current production season; confirm final pricing with our sales team before
              ordering. FOB Qingdao is standard — CFR, CIF and DDP to major ports are available on request.
            </p>
          </div>
        </div>
        <div class="mt-4 flex flex-wrap gap-2 text-sm">
          <a
            href="/guides/how-much-does-a-wholesale-drop-stitch-pool-cost"
            class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
            >Wholesale Cost Guide</a
          >
          <a
            href="/guides/inflatable-pool-container-loading-guide"
            class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
            >Container Loading Guide</a
          >
          <a
            href="/guides"
            class="px-4 py-2 rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 font-medium"
            >All Procurement Guides</a
          >
        </div>
      </section>

      <!-- Pressure & Safety Specifications -->
      <section id="pressure" class="scroll-mt-24">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">
          Pressure & Safety Specifications
        </h2>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">
          Drop-stitch pools use a model-specific recommended operating pressure. Air-chamber side walls carry a
          pressure-relief valve; the relief setting and maximum inflation pressure are confirmed in the specification
          for each model. Production pressure and leak testing follows the method, hold time and acceptance criteria
          agreed in the approved specification.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {
            POOL_PRESSURE_SPECS.map((p) => (
              <div class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
                <div class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-1">
                  {p.label}
                </div>
                <div class="text-sm font-bold text-gray-900 dark:text-slate-100">{p.value}</div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Production Process -->
      <section id="production" class="scroll-mt-24">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">Production Process</h2>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">
          Every Inflatable Pool Factory pool goes through the same five-step factory workflow — from CNC-cut drop-stitch
          fabric to pressure and leak testing against the approved production specification before packing.
        </p>
        <ol class="space-y-3">
          {
            POOL_PRODUCTION_STEPS.map((step, i) => (
              <li class="flex gap-4 p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-sky-100 dark:bg-sky-900/50 text-sky-700 dark:text-sky-300 text-sm font-bold">
                  {i + 1}
                </span>
                <div>
                  <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1">{step.title}</h3>
                  <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Product Videos -->
      <section id="videos" class="scroll-mt-24">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">Product Videos</h2>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">
          Watch the drop-stitch pools inflate to full rigidity and hold shape under load.
        </p>
        <div class="grid md:grid-cols-2 gap-4">
          <video
            controls
            preload="metadata"
            class="w-full aspect-video rounded-xl bg-black border border-gray-200 dark:border-slate-700"
            aria-label="Inflatable Pool Factory drop-stitch pool demo video 1"
          >
            <source src="/videos/pools/inflatablepoolfactory-pool-demo-1.mp4" type="video/mp4" />
          </video>
          <video
            controls
            preload="metadata"
            class="w-full aspect-video rounded-xl bg-black border border-gray-200 dark:border-slate-700"
            aria-label="Inflatable Pool Factory drop-stitch pool demo video 2"
          >
            <source src="/videos/pools/inflatablepoolfactory-pool-demo-2.mp4" type="video/mp4" />
          </video>
        </div>
      </section>

      <!-- Why Import Drop-Stitch Pools -->
      <section id="advantages" class="scroll-mt-24">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-1">
          Why Import Drop-Stitch Pools
        </h2>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">
          The commercial case for wholesale drop-stitch pool programs versus rigid acrylic/FRP pools and entry-level
          vinyl inflatables.
        </p>
        <div class="grid sm:grid-cols-2 gap-4">
          {
            POOL_BUSINESS_ADVANTAGES.map((adv) => (
              <div class="flex gap-4 p-5 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
                <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-xl bg-sky-100 dark:bg-sky-900/50 text-primary dark:text-sky-300">
                  <Icon name={adv.icon} class="w-5 h-5" />
                </span>
                <div>
                  <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100 mb-1">{adv.title}</h3>
                  <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{adv.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <!-- CTA -->
    <div class="mt-14 text-center">
      <p class="text-lg text-gray-600 dark:text-slate-400 mb-5 max-w-2xl mx-auto">
        Prices are indicative FOB Qingdao reference prices. For quantity terms, mixed containers, custom sizes, or
        OEM/ODM projects, request an itemized quotation.
      </p>
      <a
        href="/request-quotation"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-gray-900 dark:bg-slate-700 text-white font-semibold rounded-full hover:bg-gray-800 dark:hover:bg-slate-600 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-sm"
      >
        <Icon name="tabler:file-invoice" class="w-5 h-5" />
        Request a Quotation
      </a>
    </div>
  </section>

  <section class="sr-only" data-ai-block="specification" aria-hidden="true">
    <p>
      Inflatable Pool Factory price list: drop-stitch inflatable pools FOB Qingdao; quantity basis and final price are
      confirmed in the quotation. Round pools 10/15 cm wall from 2×0.5 m to 10×1.2 m ($137.96–$1,600.58);
      rectangular/square pools 15/20/50 cm wall from 2×2×0.8 m to 6×5×1.5 m ($285.70–$1,753.74); hot tub SPA models with
      built-in seats and 5 mm insulated bottom ($381.36–$667.06 square/rectangular, $390.29–$487.22 round). Accessories:
      inflatable stairs, 4-step ladder, rechargeable pump, FS-12C sand filter pump. Operating pressure, relief-valve
      setting and maximum tolerance are confirmed in the model specification. Five-step production process: CNC cutting,
      valve heat-sealing, panel welding with rail reinforcement, accessory integration, and pressure/leak testing
      against the approved production specification. Key features: rigid walls with model-specific operating pressure,
      self-supporting integrated shell, sizes from 1.5 m plunge pools to 10 m commercial pools, 5–15 minute
      single-person setup with the included 1000W pump. Commercial advantages: deflated packaging at 5–10% of rigid
      acrylic/FRP pool volume for efficient 20GP/40HQ container loading, mid-to-high-end positioning, plug-and-play
      installation without excavation, and a cross-sell accessory ecosystem.
    </p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
</Layout>
