---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'site:config';
import { getProducts } from '~/utils/products';

const metadata = {
  title: `Product Comparison — ${SITE.name}`,
  description:
    'Compare Inflatable Pool Factory inflatable swimming pools side by side. Size, capacity, material, and more.',
};

const products = await getProducts();

const specGetter = (label: string) => {
  return (p: (typeof products)[number]) => {
    const s = p.specs?.find((s) => s.label.toLowerCase().includes(label));
    return s?.value || '-';
  };
};

const comparisonRows = [
  { label: 'Category', key: 'categoryLabel' as const, transform: (v: string) => v },
  { label: 'Shape', key: 'shape' as const, getter: specGetter('shape') },
  { label: 'Color', key: 'color' as const, getter: specGetter('color') },
  { label: 'Wall Material', key: 'material' as const, getter: specGetter('material') },
  { label: 'Recommended Pressure', key: 'pressure' as const, getter: specGetter('pressure') },
  { label: 'Wall Thickness', key: 'thickness' as const, getter: specGetter('thickness') },
  { label: 'Setup Time', key: 'setup' as const, getter: specGetter('setup') },
  { label: 'Included', key: 'included' as const, getter: specGetter('included') },
  {
    label: 'Price',
    key: 'price' as const,
    getter: (p: (typeof products)[number]) => {
      if (!p.price?.amount) return '-';
      return p.price.currency === 'USD' || !p.price.currency
        ? `$${p.price.amount}`
        : `${p.price.currency} ${p.price.amount}`;
    },
  },
];
---

<Layout metadata={metadata}>
  <section class="max-w-6xl mx-auto py-24 px-6">
    <a href="/products" class="text-sm text-sky-700 hover:text-sky-800">&larr; Products</a>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">Product Comparison</h1>
    <p class="mt-4 text-lg text-gray-500">
      Compare all Inflatable Pool Factory pools side by side. Find the right inflatable swimming pool for your backyard.
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/spec-sheets/product-comparison.pdf"
        download
        class="inline-flex items-center gap-2 px-5 py-3 bg-sky-700 text-white text-sm font-semibold rounded-lg hover:bg-sky-800 transition-colors"
      >
        Download comparison PDF
      </a>
      <a
        href="/products/specs"
        class="inline-flex items-center gap-2 px-5 py-3 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors"
      >
        Size &amp; FOB price matrix
      </a>
    </div>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr>
            <th
              class="sticky left-0 bg-white z-10 px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200 min-w-[140px]"
              >Specification</th
            >
            {
              products.map((p) => (
                <th class="px-4 py-3 text-center font-semibold text-gray-900 border-b-2 border-gray-200 min-w-[120px]">
                  <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{p.categoryLabel}</div>
                  <a href={`/products/${p.slug}`} class="hover:text-sky-600">
                    {p.title}
                  </a>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            comparisonRows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}>
                <td
                  class="sticky left-0 px-4 py-3 font-medium text-gray-700 border-b border-gray-200"
                  style={i % 2 === 0 ? 'background:#f9fafb' : 'background:white'}
                >
                  {row.label}
                </td>
                {products.map((p) => {
                  const value = row.getter ? row.getter(p) : (p as any)[row.key];
                  return <td class="px-4 py-3 text-center text-gray-600 border-b border-gray-200">{value || '-'}</td>;
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold text-gray-900">Download specification sheets</h2>
      <p class="mt-2 max-w-3xl text-sm text-gray-500">
        Print-ready A4 PDFs generated from the published product data. Reference prices are FOB Qingdao and are
        confirmed in the quotation.
      </p>
      <div class="mt-6 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        <a
          href="/spec-sheets/product-comparison.pdf"
          download
          class="block p-4 bg-white border border-gray-200 rounded-xl hover:shadow-md hover:border-sky-300 transition-all"
        >
          <span class="block text-xs font-semibold uppercase tracking-wider text-sky-700">All products</span>
          <span class="mt-1 block font-semibold text-gray-900">Comparison chart (PDF)</span>
          <span class="mt-1 block text-xs text-gray-500">Side-by-side A4 landscape table &darr;</span>
        </a>
        {
          products.map((p) => (
            <a
              href={`/spec-sheets/${p.slug}.pdf`}
              download
              class="block p-4 bg-white border border-gray-200 rounded-xl hover:shadow-md hover:border-sky-300 transition-all"
            >
              <span class="block text-xs font-semibold uppercase tracking-wider text-sky-700">{p.categoryLabel}</span>
              <span class="mt-1 block font-semibold text-gray-900">{p.title}</span>
              <span class="mt-1 block text-xs text-gray-500">Specification sheet (PDF) &darr;</span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        products.map((p) => (
          <a
            href={`/products/${p.slug}`}
            class="block p-4 bg-white border border-gray-200 rounded-xl hover:shadow-md transition-shadow text-center"
          >
            <div class="text-xs uppercase tracking-wider text-sky-700 font-medium">{p.categoryLabel}</div>
            <div class="mt-1 font-semibold text-gray-900">{p.title}</div>

            <div class="mt-2 text-xs text-sky-700 underline underline-offset-2 hover:underline">View details →</div>
          </a>
        ))
      }
    </div>

    <section class="sr-only" data-ai-block="definition" aria-hidden="true">
      <p>
        Inflatable Pool Factory product comparison table covering {products.length} products across {
          ['pool'].filter((c) => products.some((p) => p.category === c)).length
        } categories. Compare shape, color, wall material, pressure, and price.
      </p>
    </section>
  </section>
</Layout>
