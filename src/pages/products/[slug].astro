---
import type { InferGetStaticPropsType } from 'astro';
import type { ImageMetadata } from 'astro';
import Icon from '~/components/ui/Icon.astro';
import { Image } from 'astro:assets';
import merge from 'lodash.merge';
import ProductLayout from '~/layouts/ProductLayout.astro';
import ProductCard from '~/components/widgets/ProductCard.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Tldr from '~/components/common/Tldr.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';

import { findRelatedProducts, getStaticPathsProduct } from '~/utils/products';
import { findImage } from '~/utils/images';
import { SITE } from 'astrowind:config';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import type { MetaData } from '~/types';
import { products as productRecords } from '~/data/products';
import { poolSeries } from '~/data/pool-catalog';
import { guides } from '~/data/guides';
import { getProductCompliance } from '~/data/product-compliance';
import { productBusinessData } from '~/data/product-business-data';
import { getProductMentionsJsonLd } from '~/data/knowledge-graph';

export const prerender = true;

export const getStaticPaths = getStaticPathsProduct;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { product } = Astro.props as Props;
const rec = productRecords.find((p) => p.id === product.slug);
const url = getCanonical(getPermalink(product.permalink, 'product'));
const image = await findImage(product.image);
const gallery = await Promise.all(
  (product.gallery ?? []).map(async (g) => ({
    raw: await findImage(g.url),
    alt: g.alt || product.title,
  }))
);
const related = await findRelatedProducts(product, 3);
const relatedGuides = rec ? guides.filter((g) => g.relatedProducts.includes(rec.id)).slice(0, 3) : [];

const defaultTitle = product.title;
const defaultDesc =
  (product.summary ?? product.description)
    ? `${product.summary ?? product.description} — Contact ${SITE.name} for pricing, specs, and ordering.`
    : `Explore the ${product.title} from ${SITE.name}. Contact us for pricing, technical specs, and ordering information.`;

const metadata = merge(
  {
    title: defaultTitle,
    description: defaultDesc,
    canonical: url,
    robots: { index: !product.draft, follow: true },
    openGraph: {
      type: 'website',
      ...(image ? { images: [{ url: image, width: 1200, height: 630 }] } : {}),
    },
  },
  product.metadata ? { ...product.metadata, canonical: product.metadata.canonical || url } : {}
) as MetaData;

const productCrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products' },
  ...(product.categoryLabel
    ? [
        {
          name: product.categoryLabel,
          href: `/products?category=${product.category || 'pool'}`,
        },
      ]
    : []),
  { name: product.title },
];

const specRows = product.specs ?? [];

const productCompliance = getProductCompliance(product.category);
const productMentions = rec ? getProductMentionsJsonLd(rec.id) : [];
const businessAudience = productBusinessData[rec?.id || '']?.bestFor
  ? productBusinessData[rec!.id].bestFor.map((b) =>
      b === 'families' ? 'Families & Homeowners' : b === 'retailers' ? 'Retailers & Pool Businesses' : 'OEM Partners'
    )
  : [];
const specEntries: Array<{ name: string; value: string }> = [
  ...(rec?.ai_specs
    ? Object.entries(rec.ai_specs)
        .filter(([, v]) => v)
        .map(([k, v]) => ({ name: k, value: String(v) }))
    : []),
  ...(product.specs?.map((s: { label?: string; value?: string }) => ({ name: s.label || '', value: s.value || '' })) ??
    []),
]
  .filter((s) => s.name && s.value)
  .slice(0, 16);

const productExtraData: Record<string, unknown> = {
  ...(productMentions.length > 0 ? { mentions: productMentions } : {}),
  ...(businessAudience.length > 0 ? { audience: businessAudience } : {}),
  material: productCompliance.materialCompliance.join(', '),
  additionalProperty: specEntries.map((s) => ({ '@type': 'PropertyValue', name: s.name, value: s.value })),
  potentialAction: {
    '@type': 'BuyAction',
    target: String(url || ''),
    name: 'Buy Now',
  },
};

// ProductGroup (schema.org): express the real series → factory-size structure.
// Variants carry only verified catalog facts (item number, size, packed weight);
// no per-variant offers — the group-level Offer is the only published price.
const SERIES_BY_SLUG: Record<string, string> = {
  'round-blue-drop-stitch-pool': 'round',
  'round-grey-drop-stitch-pool': 'round',
  'rectangular-drop-stitch-pool': 'rect-square',
  'hot-tub-round': 'hot-tub-round',
  'hot-tub-square-rect': 'hot-tub-square-rect',
};
const catalogSeries = poolSeries.find((s) => s.id === SERIES_BY_SLUG[product.slug]);
const hasVariant = catalogSeries
  ? catalogSeries.items.map((it) => ({
      '@type': 'Product',
      '@id': `${url}#item-${it.item}`,
      sku: it.item,
      name: `${catalogSeries.name} ${it.size} m`,
      size: `${it.size} m`,
      ...(it.weightKg ? { weight: `${it.weightKg} kg` } : {}),
    }))
  : undefined;
---

<ProductLayout metadata={metadata} breadcrumbs={productCrumbs}>
  <JsonLd
    type="Product"
    data={productExtraData}
    product={{
      name: product.title,
      description: product.summary ?? product.description ?? '',
      sku: product.sku,
      image: image ? String(image) : undefined,
      url: String(url || ''),
      category: product.categoryLabel,
      brandName: SITE.name,
      manufacturerName: SITE.name,
      countryOfOrigin: 'China',
      material: rec?.ai_specs?.material || 'Drop stitch PVC',
      offers: product.sku
        ? {
            // Retail product (Stripe-checkout SKU): exact retail Offer.
            '@type': 'Offer',
            availability: product.inStock === false ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
            businessFunction: 'https://schema.org/Sell',
            url: String(url || ''),
            ...(product.price?.amount
              ? {
                  price: product.price.amount,
                  priceCurrency: product.price.currency || 'USD',
                  priceSpecification: {
                    '@type': 'PriceSpecification',
                    price: product.price.amount,
                    priceCurrency: product.price.currency || 'USD',
                  },
                }
              : {}),
          }
        : {
            // Wholesale-only page (no checkout SKU): publish the FOB floor price
            // as AggregateOffer lowPrice — never as an exact retail price.
            '@type': 'AggregateOffer',
            availability: product.inStock === false ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
            businessFunction: 'https://schema.org/Sell',
            url: String(url || ''),
            ...(product.price?.amount
              ? {
                  lowPrice: product.price.amount,
                  priceCurrency: product.price.currency || 'USD',
                }
              : {}),
          },
      additionalProperty: specEntries.map((s) => ({ '@type': 'PropertyValue', name: s.name, value: s.value })),
      ...(hasVariant
        ? {
            productGroupId: product.sku || catalogSeries?.id,
            variesBy: ['https://schema.org/size'],
            hasVariant,
          }
        : {}),
    }}
  />

  {/* Product Hero: Image Gallery + Info */}
  <section class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 md:py-10">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12">
        <!-- Left: Image Gallery -->
        <div class="space-y-4">
          <div class="relative aspect-[4/3] bg-gray-100 dark:bg-slate-800 rounded-2xl overflow-hidden">
            {
              gallery.length > 0 ? (
                gallery[0].raw ? (
                  (() => {
                    const img0 = gallery[0];
                    return typeof img0.raw === 'string' ? (
                      <img
                        id="gallery-main"
                        src={img0.raw}
                        alt={img0.alt || product.title}
                        class="w-full h-full object-contain p-2"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                      />
                    ) : (
                      <Image
                        id="gallery-main"
                        src={img0.raw as ImageMetadata}
                        alt={img0.alt || product.title}
                        class="w-full h-full object-contain p-2"
                        widths={[480, 768, 1024]}
                        width={768}
                        height={576}
                        format="webp"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                      />
                    );
                  })()
                ) : image ? (
                  typeof image === 'string' ? (
                    <img
                      id="gallery-main"
                      src={image}
                      alt={product.title}
                      class="w-full h-full object-contain p-2"
                      loading="eager"
                      fetchpriority="high"
                      decoding="async"
                    />
                  ) : (
                    <Image
                      id="gallery-main"
                      src={image as ImageMetadata}
                      alt={product.title}
                      class="w-full h-full object-contain p-2"
                      widths={[480, 768, 1024]}
                      width={768}
                      height={576}
                      format="webp"
                      loading="eager"
                      fetchpriority="high"
                      decoding="async"
                    />
                  )
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-300 dark:text-slate-600 text-sm">
                    No image available
                  </div>
                )
              ) : image ? (
                typeof image === 'string' ? (
                  <img
                    id="gallery-main"
                    src={image}
                    alt={product.title}
                    class="w-full h-full object-contain p-2"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                ) : (
                  <Image
                    id="gallery-main"
                    src={image as ImageMetadata}
                    alt={product.title}
                    class="w-full h-full object-contain p-2"
                    widths={[480, 768, 1024]}
                    width={768}
                    height={576}
                    format="webp"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                )
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-300 dark:text-slate-600 text-sm">
                  No image available
                </div>
              )
            }
          </div>
          {
            gallery.length > 1 && (
              <div class="flex gap-3 overflow-x-auto pb-2">
                {gallery.map((g, i) => (
                  <button
                    data-gallery-thumb={typeof g.raw === 'string' ? g.raw : String(g.raw?.src || '')}
                    data-gallery-alt={g.alt || `Image ${i + 1}`}
                    class={`flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border-2 transition-colors bg-gray-100 dark:bg-slate-800 ${i === 0 ? 'border-sky-500' : 'border-transparent hover:border-sky-400'}`}
                    aria-label={`View ${g.alt || `image ${i + 1}`}`}
                  >
                    {typeof g.raw === 'string' ? (
                      <img
                        src={g.raw}
                        alt={g.alt || `Image ${i + 1}`}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    ) : g.raw ? (
                      <Image
                        src={g.raw as ImageMetadata}
                        alt={g.alt || `Image ${i + 1}`}
                        class="w-full h-full object-cover"
                        widths={[80]}
                        width={80}
                        height={80}
                        format="webp"
                        loading="lazy"
                      />
                    ) : null}
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <!-- Right: Product Info -->
        <div class="flex flex-col gap-6">
          <div>
            <div class="flex items-center gap-3 text-sm text-gray-400 dark:text-slate-500 mb-3">
              {
                product.categoryLabel && (
                  <span class="font-medium uppercase tracking-wider">{product.categoryLabel}</span>
                )
              }
              {
                product.sku && (
                  <>
                    <>
                      <span aria-hidden="true">·</span>
                      <span class="font-mono text-xs">{product.sku}</span>
                    </>
                  </>
                )
              }
            </div>
            <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-slate-100 leading-[1.15]">
              {product.title}
            </h1>
            {
              product.summary && (
                <p class="mt-3 text-base text-gray-600 dark:text-slate-400 leading-relaxed">{product.summary}</p>
              )
            }
            {
              product.price?.amount ? (
                <div class="mt-4">
                  <div class="flex items-baseline gap-3">
                    <span class="text-3xl font-bold text-gray-900 dark:text-slate-100">
                      {product.price.currency === 'USD' || !product.price.currency
                        ? `$${product.price.amount}`
                        : `${product.price.currency ?? ''} ${product.price.amount}`}
                    </span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                      {product.sku ? 'Retail price' : 'Wholesale FOB price'}
                    </span>
                    {product.inStock && <span class="text-sm font-medium text-green-600">Available to order</span>}
                  </div>
                </div>
              ) : null
            }
            {product.price?.note && <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">{product.price.note}</p>}
          </div>

          {/* Environment & Water Condition Tags */}
          {
            (product.environment && product.environment.length > 0) ||
            (product.water_condition && product.water_condition.length > 0) ? (
              <div class="flex flex-wrap gap-2">
                {product.environment?.map((e: string) => (
                  <span class="px-3 py-1.5 bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 text-xs font-medium rounded-full">
                    {e}
                  </span>
                ))}
                {product.water_condition?.map((w: string) => (
                  <span class="px-3 py-1.5 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 text-xs font-medium rounded-full">
                    {w}
                  </span>
                ))}
              </div>
            ) : null
          }

          {/* Tags */}
          {
            product.tags && product.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {product.tags.map((tag) => (
                  <span class="px-2.5 py-1 bg-gray-100 dark:bg-slate-800 text-gray-500 dark:text-slate-400 text-xs rounded-md">
                    {String((tag as any)?.title || (tag as any)?.slug || tag || '').trim()}
                  </span>
                ))}
              </div>
            )
          }

          {/* Key Specs Grid */}
          {
            specRows.length > 0 && (
              <div class="grid grid-cols-2 gap-2">
                {specRows.slice(0, 6).map((s) => (
                  <div class="flex flex-col gap-0.5 p-3 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                      {s.label}
                    </span>
                    <span class="text-sm font-medium text-gray-800 dark:text-slate-200">{s.value}</span>
                  </div>
                ))}
              </div>
            )
          }

          {/* Full Specs Toggle */}
          {
            specRows.length > 6 && (
              <details class="group">
                <summary class="text-sm font-semibold text-gray-500 dark:text-slate-400 cursor-pointer hover:text-gray-700 dark:hover:text-slate-200 transition-colors list-none flex items-center gap-2">
                  Full Specifications
                  <span class="text-[10px] group-open:rotate-180 transition-transform">&#9660;</span>
                </summary>
                <div class="mt-3 grid grid-cols-2 gap-2">
                  {specRows.slice(6).map((s) => (
                    <div class="flex items-center justify-between p-2.5 rounded-lg bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
                      <span class="text-xs font-medium text-gray-600 dark:text-slate-400 capitalize">{s.label}</span>
                      <span class="text-xs text-gray-500 dark:text-slate-500 ml-2 text-right">{s.value}</span>
                    </div>
                  ))}
                </div>
              </details>
            )
          }

          {/* CTA Buttons */}
          <div class="flex flex-col sm:flex-row gap-3 pt-2">
            {
              product.sku && product.price?.amount ? (
                <form method="POST" action="/api/checkout" class="flex-1">
                  <input type="hidden" name="sku" value={product.sku} />
                  <button
                    type="submit"
                    class="inline-flex w-full items-center justify-center gap-2 px-8 py-3.5 bg-gray-900 dark:bg-slate-700 text-white font-semibold rounded-full hover:bg-gray-800 dark:hover:bg-slate-600 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-sm"
                  >
                    <Icon name="tabler:shopping-cart" class="w-5 h-5" />
                    Buy Now
                  </button>
                </form>
              ) : null
            }
            <a
              href={`/contact?product=${encodeURIComponent(product.title)}`}
              class="inline-flex items-center justify-center gap-2 px-8 py-3.5 border-2 border-gray-200 dark:border-slate-600 text-gray-700 dark:text-slate-300 font-medium rounded-full hover:border-gray-300 dark:hover:border-slate-500 hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm"
            >
              <Icon name="tabler:message-circle" class="w-5 h-5" />
              Request a Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* TLDR (AI-crawlable) */}
  {
    rec && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 -mt-1 relative z-10">
        <Tldr
          summary={rec.definition}
          points={[`${rec.audience}`, `Use cases: ${rec.ai_use_cases.slice(0, 3).join(', ')}`]}
        />
      </section>
    )
  }

  {/* Content (MDX) */}
  {
    product.Content && (
      <section class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-16">
          <div class="prose prose-gray dark:prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3 prose-p:text-gray-600 dark:prose-p:text-slate-400 prose-p:leading-relaxed prose-li:text-gray-600 dark:prose-li:text-slate-400 prose-strong:text-gray-900 dark:prose-strong:text-slate-200 prose-ul:space-y-2 max-w-none">
            <product.Content />
          </div>
        </div>
      </section>
    )
  }

  {/* Product Definition —Who is it for? */}
  {
    rec && rec.definition && (
      <section
        class="bg-gray-50/50 dark:bg-slate-900/50 border-b border-gray-100 dark:border-slate-800"
        data-ai-block="definition"
      >
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
          <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2 block">
            Business Fit
          </span>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-4">
            Who is it for?
          </h2>
          {rec.audience && (
            <p class="text-base text-gray-600 dark:text-slate-400 leading-relaxed capitalize">{rec.audience}</p>
          )}
          {rec && productBusinessData[rec.id] && (
            <div class="mt-4 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl p-5">
              <p class="text-sm font-semibold text-orange-800 dark:text-orange-300 mb-3">Best For Your Business</p>
              <div class="flex flex-wrap gap-2 mb-3">
                {productBusinessData[rec.id].bestFor.includes('families') && (
                  <span class="inline-block text-xs font-medium bg-sky-100 dark:bg-sky-900/50 text-sky-700 dark:text-sky-300 px-3 py-1 rounded-full">
                    Families
                  </span>
                )}
                {productBusinessData[rec.id].bestFor.includes('retailers') && (
                  <span class="inline-block text-xs font-medium bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 px-3 py-1 rounded-full">
                    Retailers
                  </span>
                )}
                {productBusinessData[rec.id].bestFor.includes('oem') && (
                  <span class="inline-block text-xs font-medium bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 px-3 py-1 rounded-full">
                    OEM
                  </span>
                )}
              </div>
              <p class="text-sm text-orange-700 dark:text-orange-400 leading-relaxed">
                {productBusinessData[rec.id].recommendation}
              </p>
              <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="bg-white/70 dark:bg-slate-800/70 rounded-lg p-3">
                  <p class="text-xs font-semibold text-orange-700 dark:text-orange-400 uppercase tracking-wider mb-1">
                    Use Case
                  </p>
                  <p class="text-sm text-gray-700 dark:text-slate-300">{productBusinessData[rec.id].useCase}</p>
                </div>
                <div class="bg-white/70 dark:bg-slate-800/70 rounded-lg p-3">
                  <p class="text-xs font-semibold text-orange-700 dark:text-orange-400 uppercase tracking-wider mb-1">
                    Operating Cost
                  </p>
                  <p class="text-sm text-gray-700 dark:text-slate-300">{productBusinessData[rec.id].operatingCost}</p>
                </div>
                <div class="bg-white/70 dark:bg-slate-800/70 rounded-lg p-3">
                  <p class="text-xs font-semibold text-orange-700 dark:text-orange-400 uppercase tracking-wider mb-1">
                    Expected Lifespan
                  </p>
                  <p class="text-sm text-gray-700 dark:text-slate-300">{productBusinessData[rec.id].lifespan}</p>
                </div>
                <div class="bg-white/70 dark:bg-slate-800/70 rounded-lg p-3">
                  <p class="text-xs font-semibold text-orange-700 dark:text-orange-400 uppercase tracking-wider mb-1">
                    Why Businesses Choose It
                  </p>
                  <p class="text-sm text-gray-700 dark:text-slate-300">
                    {productBusinessData[rec.id].whyBusinessesChooseIt}
                  </p>
                </div>
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* Comparison */}
  {
    rec && rec.ai_comparison && (
      <section
        class="bg-gray-50/50 dark:bg-slate-900/50 border-b border-gray-100 dark:border-slate-800"
        data-ai-block="comparison"
      >
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
          <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2 block">
            Comparison
          </span>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-4">
            How it compares
          </h2>
          <p class="text-base text-gray-600 dark:text-slate-400 leading-relaxed">{rec.ai_comparison}</p>
        </div>
      </section>
    )
  }

  {/* FAQ Section */}
  {
    rec && rec.ai_faq.length > 0 && (
      <section class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-8">
            Frequently Asked Questions
          </h2>
          <div class="space-y-3">
            {rec.ai_faq.map((f) => (
              <details class="group rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 open:shadow-sm transition-shadow">
                <summary class="flex items-center justify-between px-5 py-4 cursor-pointer text-sm font-semibold text-gray-900 dark:text-slate-200 list-none">
                  {f.q}
                  <span class="shrink-0 ml-2 text-gray-300 dark:text-slate-600 group-open:rotate-180 transition-transform text-xs">
                    &#9660;
                  </span>
                </summary>
                <div class="px-5 pb-4 text-sm text-gray-600 dark:text-slate-400 leading-relaxed border-t border-gray-100 dark:border-slate-700 pt-3 mt-0">
                  {f.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <JsonLd type="FAQPage" faqs={rec?.ai_faq || []} />

  {/* Safety & Usage */}
  {
    rec && rec.safety_rules.length > 0 && (
      <section class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800" data-ai-block="safety">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
            Safety &amp; Usage
          </h2>
          <div class="bg-amber-50/80 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl px-6 py-5">
            <ul class="space-y-2.5">
              {rec.safety_rules.map((rule) => (
                <li class="flex items-start gap-3 text-sm text-gray-700 dark:text-slate-300 leading-relaxed">
                  <span class="w-1.5 h-1.5 mt-2 rounded-full bg-amber-500 flex-shrink-0" />
                  <span class="capitalize">{rule}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  {/* Materials & Construction */}
  {
    rec && rec.ai_specs && (
      <section class="bg-gray-50/50 dark:bg-slate-900/50 border-b border-gray-100 dark:border-slate-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
          <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2 block">
            Construction
          </span>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
            Materials & Construction
          </h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {Object.entries(rec.ai_specs)
              .filter(([k]) => !['length', 'width', 'height', 'weight', 'max_load', 'pressure', 'warranty'].includes(k))
              .slice(0, 6)
              .map(([k, v]) => (
                <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-5">
                  <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-1">
                    {k.replace(/_/g, ' ')}
                  </div>
                  <div class="text-sm font-medium text-gray-900 dark:text-slate-200">{v}</div>
                </div>
              ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Compliance & Documentation */}
  <section class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
      <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2 block"
        >Compliance</span
      >
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
        Compliance & Documentation
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-gray-50 dark:bg-slate-800/50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-green-600 text-lg">&#10003;</span>
            <h3 class="font-semibold text-gray-900 dark:text-slate-100">Documentation</h3>
          </div>
          <div class="space-y-2">
            {
              productCompliance.certs.map((c: any) => (
                <div class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-500 mt-2 shrink-0" />
                  <div>
                    <span class="text-sm font-medium text-gray-900 dark:text-slate-200">{c.label}</span>
                    {c.standard && <span class="text-xs text-gray-500 dark:text-slate-400"> ({c.standard})</span>}
                    {c.body && (
                      <span class="text-xs text-gray-400 dark:text-slate-500 block">Provided by {c.body}</span>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="bg-gray-50 dark:bg-slate-800/50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-green-600 text-lg">&#10003;</span>
            <h3 class="font-semibold text-gray-900 dark:text-slate-100">Material Documentation</h3>
          </div>
          <div class="space-y-2">
            {
              productCompliance.materialCompliance.map((m: string) => (
                <div class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-500 mt-2 shrink-0" />
                  <span class="text-sm text-gray-600 dark:text-slate-400">{m}</span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="bg-gray-50 dark:bg-slate-800/50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-green-600 text-lg">&#10003;</span>
            <h3 class="font-semibold text-gray-900 dark:text-slate-100">Testing & Warranty</h3>
          </div>
          <div class="space-y-2 mb-4">
            {
              productCompliance.testStandards.map((t: string) => (
                <div class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-500 mt-2 shrink-0" />
                  <span class="text-sm text-gray-600 dark:text-slate-400">{t}</span>
                </div>
              ))
            }
          </div>
          <div class="pt-3 border-t border-gray-200 dark:border-slate-700">
            <span class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider"
              >Warranty</span
            >
            <p class="text-sm text-gray-700 dark:text-slate-300 mt-1">
              {productCompliance.warranty}{' '}
              <a href="/terms" class="text-sky-600 dark:text-sky-400 hover:underline">(Terms)</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Trust Badges */}
  <section class="bg-gray-50/50 dark:bg-slate-900/50 border-b border-gray-100 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <TrustBadges layout="row" />
    </div>
  </section>

  {/* Related Products */}
  {
    related.length > 0 && (
      <section class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-14">
          <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
            Compare with other {product.categoryLabel || 'products'}
          </h2>
          <div class="grid md:grid-cols-3 gap-4">
            {related.map((p) => (
              <ProductCard product={p} showMeta={false} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Related Guides */}
  {
    relatedGuides.length > 0 && (
      <section class="bg-gray-50/50 dark:bg-slate-900/50 border-b border-gray-100 dark:border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-14">
          <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
            Related Guides
          </h2>
          <div class="grid md:grid-cols-3 gap-4">
            {relatedGuides.map((g) => (
              <a
                href={`/guides/${g.slug}`}
                class="block p-5 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 hover:shadow-md transition-shadow"
              >
                <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-200">{g.title}</h3>
                <p class="mt-1 text-xs text-gray-500 dark:text-slate-400 line-clamp-2">{g.description}</p>
                <span class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-sky-600 dark:text-sky-400">
                  Read guide
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Business & Customization */}
  <section class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800" data-ai-block="business">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
      <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2 block">
        For Businesses
      </span>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-4">
        Need custom sizes or branded products?
      </h2>
      <p class="text-gray-600 dark:text-slate-400 leading-relaxed max-w-2xl">
        Beyond the standard retail range, this product line can be reviewed for vacation rentals, glamping sites,
        retailers, and brand partners — including custom sizes, branding, packaging and OEM/ODM adaptations. Tell us how
        you plan to sell or use the pool and we will confirm the applicable options.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={`/request-quotation?product=${encodeURIComponent(product.title)}`}
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
        >
          Request a quote for this product
          <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
        <a
          href="/products/specs"
          class="inline-flex items-center gap-2 px-5 py-3 border border-gray-300 dark:border-slate-700 text-gray-700 dark:text-slate-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
        >
          <Icon name="tabler:table" class="w-4 h-4" />
          Size &amp; FOB price matrix
        </a>
        <a
          href="/oem-odm"
          class="inline-flex items-center gap-2 px-5 py-3 border border-gray-300 dark:border-slate-700 text-gray-700 dark:text-slate-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
        >
          OEM / ODM capabilities
        </a>
        <a
          href="/manufacturing"
          class="inline-flex items-center gap-2 px-5 py-3 border border-gray-300 dark:border-slate-700 text-gray-700 dark:text-slate-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
        >
          Manufacturing process
        </a>
        <a
          href="/quality-control"
          class="inline-flex items-center gap-2 px-5 py-3 border border-gray-300 dark:border-slate-700 text-gray-700 dark:text-slate-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
        >
          Quality control
        </a>
      </div>
    </div>
  </section>

  {/* Final CTA */}
  <section class="bg-gray-900 dark:bg-slate-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 md:py-18 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-4">Order Your {product.title} Today</h2>
      <p class="text-lg text-white/70 mb-8 max-w-xl mx-auto">
        Buy online with secure Stripe checkout, or contact our team for custom sizes and OEM orders.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        {
          product.sku && product.price?.amount ? (
            <form method="POST" action="/api/checkout">
              <input type="hidden" name="sku" value={product.sku} />
              <button
                type="submit"
                class="inline-flex items-center gap-2 px-8 py-4 bg-white text-gray-900 font-semibold rounded-full hover:bg-gray-100 transition-all shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
              >
                <Icon name="tabler:shopping-cart" class="w-5 h-5" />
                Buy Now
              </button>
            </form>
          ) : null
        }
        <a
          href={`/request-quotation?product=${encodeURIComponent(product.title)}`}
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-medium rounded-full hover:bg-white/10 transition-all"
        >
          Request an OEM / Bulk Quote
        </a>
      </div>
    </div>
  </section>

  {/* Checkout Result Banner */}
  <script>
    const checkoutStatus = new URLSearchParams(window.location.search).get('checkout');
    if (checkoutStatus === 'success' || checkoutStatus === 'canceled') {
      const banner = document.createElement('div');
      const ok = checkoutStatus === 'success';
      banner.className = `fixed bottom-6 left-1/2 -translate-x-1/2 z-50 max-w-md w-[calc(100%-2rem)] px-5 py-4 rounded-xl shadow-2xl text-sm font-medium ${
        ok ? 'bg-green-600 text-white' : 'bg-gray-800 text-white'
      }`;
      banner.textContent = ok
        ? 'Thank you! Your order is confirmed — check your email for the receipt.'
        : 'Checkout canceled. You were not charged.';
      document.body.appendChild(banner);
      window.setTimeout(() => banner.remove(), 8000);
    }
  </script>

  {/* Image Gallery Script */}
  <script>
    if (document.querySelector('[data-gallery-thumb]')) {
      const thumbnails = document.querySelectorAll<HTMLElement>('[data-gallery-thumb]');
      const mainImage = document.getElementById('gallery-main');
      if (thumbnails && mainImage) {
        thumbnails.forEach((thumb) => {
          thumb.addEventListener('click', () => {
            const url = thumb.dataset.galleryThumb;
            const alt = thumb.dataset.galleryAlt || '';
            if (url) {
              mainImage.setAttribute('src', url);
              mainImage.setAttribute('alt', alt);
              thumbnails.forEach((t) => t.classList.remove('border-sky-500'));
              thumb.classList.add('border-sky-500');
            }
          });
        });
      }
    }
  </script>

  <ToBlogLink text="Back to Products" />
</ProductLayout>
