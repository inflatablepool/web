---
export interface Props {
  title: string;
  subtitle: string;
  featuredLabel?: string;
  packages: Array<{
    name: string;
    description: string;
    audience: string;
    items: string[];
    cta: string;
    ctaHref: string;
    featured?: boolean;
  }>;
}

const { title, subtitle, featuredLabel = 'Most Popular', packages } = Astro.props;
---

<section class="bg-gray-50 dark:bg-slate-900/50 border-b border-gray-100 dark:border-slate-800 py-16 md:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-slate-100">{title}</h2>
      <p class="mt-3 text-gray-600 dark:text-slate-400 max-w-2xl mx-auto">{subtitle}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {
        packages.map((pkg) => (
          <div
            class={`relative flex flex-col rounded-2xl border ${pkg.featured ? 'border-sky-300 dark:border-sky-600 shadow-lg shadow-sky-100 dark:shadow-sky-900/20' : 'border-gray-200 dark:border-slate-700'} bg-white dark:bg-slate-800 p-6`}
          >
            {pkg.featured && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-sky-500 text-white text-xs font-bold px-4 py-1 rounded-full">
                {featuredLabel}
              </div>
            )}
            <h3 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-1">{pkg.name}</h3>
            <p class="text-xs text-gray-600 dark:text-slate-400 mb-4">{pkg.description}</p>
            <div class="text-xs font-semibold text-sky-700 dark:text-sky-400 uppercase tracking-wider mb-3">
              {pkg.audience}
            </div>
            <ul class="space-y-2 mb-6 flex-1">
              {pkg.items.map((item) => (
                <li class="flex items-start gap-2 text-sm text-gray-700 dark:text-slate-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-500 mt-1.5 flex-shrink-0" />
                  {item}
                </li>
              ))}
            </ul>
            <a
              href={pkg.ctaHref}
              class={`inline-flex items-center justify-center gap-2 w-full text-sm font-semibold px-5 py-3 rounded-xl transition-all ${pkg.featured ? 'bg-sky-600 hover:bg-sky-700 text-white shadow-md' : 'bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-900 dark:text-slate-100'}`}
            >
              {pkg.cta}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
