---
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';

interface FieldOption {
  value: string;
  label: string;
}

interface Field {
  name: string;
  label: string;
  row: number;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  required?: boolean;
  withCountryCode?: boolean;
  rows?: number;
  placeholder?: string;
  optionsKey?: string;
  options?: Array<FieldOption | string>;
}

interface ConsentConfig {
  required?: boolean;
  text?: string;
  link_text?: string;
  link_href?: string;
  error_message?: string;
}

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  tagline?: string;
  emailTo?: string;
  emailSubject?: string;
  submitButton?: string;
  successMessage?: string;
  errorMessage?: string;
  fields?: Field[];
  consent?: ConsentConfig;
  defaultCountryCode?: string;
  countryCodes?: Array<{ code: string; label: string }>;
  countries?: FieldOption[];
  isDark?: boolean;
  classes?: { container?: string };
  bg?: any;
  enableFileUpload?: boolean;
  fileLabel?: string;
  fileHint?: string;
  fileMaxMB?: number;
}

const {
  id = 'form',
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  emailTo = '',
  emailSubject = '',
  submitButton = 'Send message',
  successMessage = 'Thanks! Your message has landed in our inbox.',
  errorMessage = 'Something went wrong. Please try again.',
  fields = [],
  consent,
  defaultCountryCode = '+86',
  countryCodes = [],
  countries = [],
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
  enableFileUpload = false,
  fileLabel = 'Attachment (optional)',
  fileHint = 'Spec sheet, drawing or catalog — PNG, JPG, SVG, WebP, PDF, AI, PSD, DWG, DXF or ZIP, up to 20 MB.',
  fileMaxMB = 20,
} = Astro.props;

const consentRequired = consent?.required === true;
const turnstileSiteKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined) || '';
const consentText = consent?.text || 'I agree to the processing of my personal data in accordance with the';
const consentLinkText = consent?.link_text || 'Privacy Policy';
const consentLinkHref = consent?.link_href || '/privacy';
const consentError = consent?.error_message || 'Please confirm that you accept the Privacy Policy before submitting.';

const resolveOptions = (f: Field): FieldOption[] => {
  const raw =
    Array.isArray(f.options) && f.options.length > 0 ? f.options : f.optionsKey === 'countries' ? countries : [];
  return raw.map((option) => (typeof option === 'string' ? { value: option, label: option } : option));
};

const grouped: Record<number, Field[]> = {};
for (const f of fields) {
  if (!grouped[f.row]) grouped[f.row] = [];
  grouped[f.row].push(f);
}
const rows = Object.keys(grouped)
  .map((k) => Number(k))
  .sort((a, b) => a - b);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div
    class="flex flex-col max-w-2xl mx-auto rounded-lg backdrop-blur border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow p-4 sm:p-6 lg:p-8 w-full"
  >
    <form
      id={`${id}-form`}
      method="POST"
      action="/api/contact"
      class="space-y-7"
      data-contact-form
      data-success-message={successMessage}
      data-error-message={errorMessage}
    >
      <input type="hidden" name="email_to" value={emailTo} />
      {emailSubject && <input type="hidden" name="subject" value={emailSubject} />}
      <div
        aria-hidden="true"
        style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;opacity:0;pointer-events:none"
      >
        <label for={`${id}-email-confirm`}>Do not fill this</label>
        <input id={`${id}-email-confirm`} type="text" name="email_confirm" tabindex="-1" autocomplete="off" />
      </div>
      {
        turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme={isDark ? 'dark' : 'light'} />
        )
      }
      <div data-form-fields>
        {
          rows.map((rowIdx) => {
            const row = grouped[rowIdx];
            const isWide =
              row.length === 1 && (row[0].type === 'textarea' || row[0].type === 'text' || row[0].type === 'email');
            if (isWide) {
              const f = row[0];
              if (f.type === 'textarea') {
                return (
                  <div>
                    <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">
                      {f.label}
                    </label>
                    <textarea
                      id={`${id}-${f.name}`}
                      name={f.name}
                      rows={f.rows ?? 4}
                      placeholder={f.placeholder}
                      required={f.required}
                      data-field-label={f.label}
                      class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
                    />
                  </div>
                );
              }
              return (
                <div>
                  <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">
                    {f.label}
                  </label>
                  <input
                    id={`${id}-${f.name}`}
                    type={(f.type === 'select' ? 'text' : (f.type ?? 'text')) as any}
                    name={f.name}
                    placeholder={f.placeholder}
                    required={f.required}
                    data-field-label={f.label}
                    class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
                  />
                </div>
              );
            }
            return (
              <div class={`grid grid-cols-1 sm:grid-cols-${row.length} gap-4`}>
                {row.map((f) => {
                  if (f.withCountryCode) {
                    return (
                      <div>
                        <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">
                          {f.label}
                        </label>
                        <div class="flex gap-2">
                          <select
                            name={`${f.name}_countryCode`}
                            data-tel-country
                            class="py-2 px-2 block w-40 text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
                            aria-label="Country code"
                          >
                            {countryCodes.map((c) => (
                              <option value={c.code} selected={c.code === defaultCountryCode}>
                                {c.label}
                              </option>
                            ))}
                          </select>
                          <input
                            id={`${id}-${f.name}`}
                            type="tel"
                            name={f.name}
                            inputmode="numeric"
                            placeholder={f.placeholder ?? '555 123 4567'}
                            required={f.required}
                            data-field-label={f.label}
                            class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
                          />
                        </div>
                      </div>
                    );
                  }
                  if (f.type === 'select') {
                    const opts = resolveOptions(f);
                    return (
                      <div>
                        <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">
                          {f.label}
                        </label>
                        <select
                          id={`${id}-${f.name}`}
                          name={f.name}
                          data-field-label={f.label}
                          class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
                          required={f.required !== false}
                        >
                          {f.placeholder && (
                            <option value="" disabled selected>
                              {f.placeholder}
                            </option>
                          )}
                          {opts.map((o) => (
                            <option value={o.value}>{o.label}</option>
                          ))}
                        </select>
                      </div>
                    );
                  }
                  return (
                    <div>
                      <label for={`${id}-${f.name}`} class="block text-sm font-medium mb-1">
                        {f.label}
                      </label>
                      <input
                        id={`${id}-${f.name}`}
                        type={(f.type === 'email' ? 'email' : f.type === 'tel' ? 'tel' : 'text') as any}
                        name={f.name}
                        placeholder={f.placeholder}
                        required={f.required}
                        data-field-label={f.label}
                        class="py-2 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
                      />
                    </div>
                  );
                })}
              </div>
            );
          })
        }
      </div>

      {
        enableFileUpload && (
          <div>
            <label for={`${id}-file`} class="block text-sm font-medium mb-1">
              {fileLabel}
            </label>
            <input
              id={`${id}-file`}
              type="file"
              name="file"
              accept=".png,.jpg,.jpeg,.svg,.webp,.pdf,.ai,.psd,.dwg,.dxf,.zip"
              data-file-input
              data-max-mb={String(fileMaxMB)}
              class="block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 file:mr-4 file:rounded-md file:border-0 file:bg-sky-50 dark:file:bg-slate-800 file:px-4 file:py-2 file:text-sm file:font-medium file:text-sky-700 dark:file:text-sky-300 hover:file:bg-sky-100 dark:hover:file:bg-slate-700 cursor-pointer"
            />
            <p class="mt-1 text-xs text-muted dark:text-slate-400">{fileHint}</p>
            <p data-file-error class="hidden mt-1 text-xs text-red-600 dark:text-red-400" />
          </div>
        )
      }

      {
        consent && (
          <div class="pt-2 border-t border-gray-200 dark:border-gray-700">
            <label class="flex items-start gap-3 text-sm text-muted dark:text-slate-300 cursor-pointer select-none">
              <input
                type="checkbox"
                name="consent"
                data-consent
                data-consent-error={consentError}
                required={consentRequired}
                class="mt-1 h-4 w-4 shrink-0 rounded border-gray-300 dark:border-gray-600 text-primary focus:ring-primary cursor-pointer"
              />
              <span class="leading-relaxed">
                {consentText}{' '}
                <a
                  href={consentLinkHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary underline underline-offset-2 hover:text-secondary dark:text-blue-400"
                >
                  {consentLinkText}
                </a>
                .
              </span>
            </label>
            <p data-consent-error class="hidden mt-1 text-xs text-red-600 dark:text-red-400" />
          </div>
        )
      }

      <div class="pt-2">
        <Button type="submit" variant="primary" data-submit-button>{submitButton}</Button>
      </div>

      <div data-form-status class="hidden text-sm font-medium"></div>
    </form>
  </div>
</WidgetWrapper>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script is:inline>
  (function () {
    const forms = document.querySelectorAll('form[data-contact-form]');
    forms.forEach((formEl) => {
      if (!(formEl instanceof HTMLFormElement)) return;
      const statusEl = formEl.querySelector('[data-form-status]');
      const successMsg = formEl.dataset.successMessage || 'Thanks!';
      const errorMsg = formEl.dataset.errorMessage || 'Something went wrong.';
      const consentEl = formEl.querySelector('[data-consent]');
      const consentErrorEl = formEl.querySelector('[data-consent-error]');

      formEl.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!(formEl instanceof HTMLFormElement)) return;
        if (consentErrorEl) {
          consentErrorEl.classList.add('hidden');
          consentErrorEl.textContent = '';
        }
        if (consentEl instanceof HTMLInputElement && consentEl.required && !consentEl.checked) {
          if (consentErrorEl) {
            consentErrorEl.textContent =
              consentEl.dataset.consentError || 'Please confirm that you accept the Privacy Policy before submitting.';
            consentErrorEl.classList.remove('hidden');
          }
          consentEl.focus();
          return;
        }

        const submitBtn = formEl.querySelector('[data-submit-button]');
        const submitLabel = submitBtn ? submitBtn.textContent || 'Send message' : 'Send message';
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending…';
        }

        const fd = new FormData(formEl);
        const data = {};
        for (const [k, v] of fd.entries()) {
          if (typeof v === 'string') data[k] = v.trim();
        }
        // Honeypot guard: browsers/password managers may autofill the off-screen
        // email_confirm field despite autocomplete="off". This page's own JS must
        // never ship it (server still catches raw-HTTP bots that fill it directly).
        delete data.email_confirm;
        const honeypotEl = formEl.querySelector('input[name="email_confirm"]');
        if (honeypotEl instanceof HTMLInputElement) honeypotEl.value = '';
        const cc = data.tel_countryCode || '';
        if (data.tel) data.tel = `${cc} ${data.tel}`.trim();
        delete data.tel_countryCode;

        // Keep the worker's required schema (firstName, lastName, email, message)
        // while preserving form-specific fields such as buyer type, product type,
        // quantity and customization level in the notification and D1 record.
        const knownFields = new Set([
          'firstName',
          'lastName',
          'companyName',
          'address',
          'zip',
          'country',
          'email',
          'tel',
          'subject',
          'message',
          'email_to',
          'consent',
          'turnstileToken',
          'locale',
        ]);
        const extraLines = [];
        for (const [k, v] of Object.entries(data)) {
          if (knownFields.has(k) || !v) continue;
          const fieldEl = formEl.querySelector(`[name="${k}"]`);
          const label = fieldEl?.getAttribute('data-field-label') || k;
          extraLines.push(`${label}: ${v}`);
        }
        if (extraLines.length > 0) {
          data.message = [data.message, 'Project details:', ...extraLines].filter(Boolean).join('\n');
        }

        // Record lead attribution without changing the worker's D1 schema.
        // The current page, campaign parameters, click IDs and external referrer
        // are appended to the required message field for sales follow-up.
        const sourceLines = [];
        if (typeof window !== 'undefined') {
          const pagePath = `${window.location.pathname}${window.location.search}`;
          sourceLines.push(`Landing page: ${pagePath.slice(0, 500)}`);

          const params = new URLSearchParams(window.location.search);
          for (const key of [
            'utm_source',
            'utm_medium',
            'utm_campaign',
            'utm_term',
            'utm_content',
            'gclid',
            'fbclid',
            'msclkid',
            'ttclid',
          ]) {
            const value = params.get(key);
            if (value) sourceLines.push(`${key}: ${value.slice(0, 200)}`);
          }

          if (document.referrer) {
            try {
              const referrer = new URL(document.referrer);
              if (referrer.origin !== window.location.origin) {
                sourceLines.push(`External referrer: ${`${referrer.origin}${referrer.pathname}`.slice(0, 300)}`);
              }
            } catch {
              // Ignore malformed referrer values.
            }
          }
        }
        if (sourceLines.length > 0) {
          data.message = [data.message, 'Inquiry source:', ...sourceLines].filter(Boolean).join('\n');
        }

        if (consentEl instanceof HTMLInputElement) data.consent = consentEl.checked ? 'true' : 'false';
        const turnstileWidget = formEl.querySelector('.cf-turnstile');
        let tw = '';
        if (typeof window !== 'undefined' && typeof window.turnstile !== 'undefined' && window.turnstile.getResponse) {
          tw = window.turnstile.getResponse(turnstileWidget instanceof HTMLElement ? turnstileWidget : undefined);
        }
        if (tw) data.turnstileToken = tw;
        const langMeta = document.querySelector('meta[name="x-locale"]');
        if (langMeta) data.locale = langMeta.getAttribute('content') || 'en';

        // Optional attachment: client-side gate mirrors the server rules
        // (extension allow-list + 20 MB cap) so users get instant feedback.
        const fileInput = formEl.querySelector('[data-file-input]');
        const fileErrorEl = formEl.querySelector('[data-file-error]');
        if (fileErrorEl) {
          fileErrorEl.classList.add('hidden');
          fileErrorEl.textContent = '';
        }
        let file = null;
        if (fileInput instanceof HTMLInputElement && fileInput.files && fileInput.files.length > 0) {
          file = fileInput.files[0];
          const allowed = ['png', 'jpg', 'jpeg', 'svg', 'webp', 'pdf', 'ai', 'psd', 'dwg', 'dxf', 'zip'];
          const name = (file.name || '').toLowerCase();
          const ext = name.includes('.') ? name.slice(name.lastIndexOf('.') + 1) : '';
          const maxMB = Number(fileInput.dataset.maxMb || '20');
          if (!allowed.includes(ext)) {
            if (fileErrorEl) {
              fileErrorEl.textContent =
                'Unsupported file type. Please attach PNG, JPG, SVG, WebP, PDF, AI, PSD, DWG, DXF or ZIP.';
              fileErrorEl.classList.remove('hidden');
            }
            if (submitBtn instanceof HTMLButtonElement) {
              submitBtn.disabled = false;
              submitBtn.textContent = submitLabel;
            }
            return;
          }
          if (file.size > maxMB * 1024 * 1024) {
            if (fileErrorEl) {
              fileErrorEl.textContent = `File too large. Maximum size is ${maxMB} MB.`;
              fileErrorEl.classList.remove('hidden');
            }
            if (submitBtn instanceof HTMLButtonElement) {
              submitBtn.disabled = false;
              submitBtn.textContent = submitLabel;
            }
            return;
          }
        }

        try {
          const controller = new AbortController();
          // Large attachments need a much longer window than a JSON body.
          const timeoutId = setTimeout(() => controller.abort(), file ? 120000 : 15000);
          let res;
          if (file) {
            const payload = new FormData();
            for (const [k, v] of Object.entries(data)) payload.append(k, v);
            payload.append('file', file, file.name);
            res = await fetch('/api/contact', {
              method: 'POST',
              body: payload,
              signal: controller.signal,
            });
          } else {
            res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
              signal: controller.signal,
            });
          }
          clearTimeout(timeoutId);
          const result = await res.json().catch(() => ({}));
          if (!res.ok || !result.success) {
            console.error('Contact form API error:', res.status, result.error || result);
            showStatus(statusEl, result.error || errorMsg, 'error');
            return;
          }
          showStatus(statusEl, successMsg, 'success');
          console.log('Contact form success:', result);
          formEl.reset();
        } catch (fetchErr) {
          console.error('Contact form fetch error:', fetchErr);
          showStatus(statusEl, 'Network error — please check your connection and try again.', 'error');
        } finally {
          if (submitBtn instanceof HTMLButtonElement) {
            submitBtn.disabled = false;
            submitBtn.textContent = submitLabel;
          }
        }
      });
    });

    function showStatus(el, msg, kind) {
      if (!el) return;
      el.classList.remove('hidden', 'text-green-600', 'text-red-600', 'dark:text-green-400', 'dark:text-red-400');
      if (kind === 'success') {
        el.classList.add('text-green-600', 'dark:text-green-400');
      } else {
        el.classList.add('text-red-600', 'dark:text-red-400');
      }
      el.textContent = msg;
    }
  })();
</script>
