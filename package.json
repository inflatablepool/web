{
  "name": "inflatable-pool-factory",
  "version": "1.0.0-beta.63",
  "description": "Inflatable Pool Factory static site, built with Astro 6 and Tailwind CSS v4.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/geo-build.mjs && node scripts/generate-data-json.mjs && npx tsx scripts/generate-geo-files.ts && node scripts/_gen-uiall.cjs && node scripts/_gen-pages.cjs && node scripts/gen-icon-svgs.cjs && node scripts/generate-image-dimensions.mjs && astro build && node scripts/mirror-root-en.mjs && node scripts/generate-sitemaps.mjs && node scripts/generate-merchant-feed.mjs && node scripts/validate-dist.mjs && node scripts/fold-untranslated-canonical.mjs && node scripts/clean-public-assets.mjs && node scripts/generate-ai-corpus.mjs",
    "build:all": "npm run build",
    "build:geo": "npx tsx scripts/generate-geo-files.ts",
    "build:r2": "node scripts/fast-upload-r2.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist/ --project-name inflatable-pool-factory",
    "deploy:all": "npm run build && npm run deploy:pages && npm run deploy:workers",
    "deploy:r2": "node scripts/fast-upload-r2.mjs",
    "deploy:r2cors": "npx wrangler r2 bucket cors set inflatable-pool-factory-assets --file scripts/r2-cors.json",
    "deploy:pages": "npx wrangler pages deploy dist/ --project-name inflatable-pool-factory",
    "deploy:worker-contact": "npx wrangler deploy -c workers/contact-worker/wrangler.toml",
    "deploy:worker-ai": "npx wrangler deploy -c workers/ai-worker/wrangler.toml",
    "deploy:worker-admin": "npx wrangler deploy -c workers/admin-worker/wrangler.toml",
    "deploy:worker-news": "npx wrangler deploy -c workers/news-worker/wrangler.toml",
    "deploy:worker-automation": "npx wrangler deploy -c workers/automation-worker/wrangler.toml",
    "deploy:workers": "node scripts/deploy-workers.mjs",
    "seo:pipeline": "node scripts/seo-pipeline.mjs",
    "geo:build": "node scripts/geo-build.mjs",
    "ai:corpus": "node scripts/generate-ai-corpus.mjs",
    "ai:seed": "node scripts/seed-vectorize.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier && npm run check:i18n",
    "check:astro": "node scripts/generate-data-json.mjs && node scripts/_gen-uiall.cjs && node scripts/_gen-pages.cjs && astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "check:i18n": "node scripts/check-translations.mjs --json --fail",
    "check:links": "node scripts/audit-dist-links.mjs",
    "validate": "node scripts/validate-dist.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@keystatic/core": "^0.5.50",
    "astro": "^7.3.2",
    "astro-auto-import": "^0.6.0",
    "astro-embed": "^0.14.0",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.2.0",
    "better-auth": "^1.7.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.1",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "marked": "^18.0.12",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/partytown": "^2.1.7",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@rollup/plugin-yaml": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "jose": "^6.2.12",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "yaml": ">=2.8.3",
    "vite": "^8"
  }
}
